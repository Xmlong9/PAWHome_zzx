.order-page {
  min-height: 100vh;
  background: #f4f4f4;
}

.tabs {
  white-space: nowrap;
  background: #fff;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02);
}

.tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 140rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #f8f8f8;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
  transition: all 0.2s;
}

.tab.active {
  background: #111;
  color: #fff;
}

.order-list {
  padding: 24rpx;
}

.order-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
}

.order-card.highlight {
  box-shadow: 0 0 0 2rpx #ff9e59 inset;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 24rpx;
}

.shop-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.platform-tag {
  font-size: 20rpx;
  color: #fff;
  background: #ff5b55;
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  line-height: 1;
}

.shop-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.arrow {
  font-size: 32rpx;
  color: #999;
  margin-left: 4rpx;
}

.status {
  font-size: 26rpx;
  color: #999;
}

.status.pending_pay,
.status.shipping {
  color: #ff5b55;
}

.goods-list {
  padding-bottom: 24rpx;
}

.goods-item {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.goods-item:last-child {
  margin-bottom: 0;
}

.goods-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #f9f9f9;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  min-width: 0;
}

.goods-name {
  font-size: 26rpx;
  color: #111;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.goods-spec {
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
  background: #f7f8fa;
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.goods-tags {
  margin-top: 12rpx;
}

.tag {
  font-size: 20rpx;
  color: #00b36b;
  border: 1rpx solid rgba(0, 179, 107, 0.3);
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.goods-price-box {
  text-align: right;
  min-width: 100rpx;
}

.goods-price {
  font-size: 26rpx;
  color: #111;
  font-weight: 600;
}

.goods-count {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.fallback-goods {
  font-size: 28rpx;
  color: #333;
  padding: 20rpx 0;
}

.total-row {
  display: flex;
  justify-content: flex-end;
  align-items: baseline;
  margin-bottom: 24rpx;
}

.total-label {
  font-size: 24rpx;
  color: #333;
  margin-right: 8rpx;
}

.total-symbol {
  font-size: 24rpx;
  color: #111;
  font-weight: 700;
}

.total-amount {
  font-size: 34rpx;
  color: #111;
  font-weight: 700;
}

.action-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.btn-more {
  font-size: 26rpx;
  color: #666;
  padding: 10rpx 20rpx 10rpx 0;
}

.btn-group {
  display: flex;
  gap: 16rpx;
}

.btn {
  height: 60rpx;
  padding: 0 32rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.btn.outline {
  border: 1rpx solid #d9d9d9;
  color: #333;
  background: #fff;
}

.btn.primary {
  border: 1rpx solid #ff5b55;
  color: #ff5b55;
  background: #fff;
}

/* Half Modal for Confirm Receipt */
.half-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s;
}

.half-modal.show {
  visibility: visible;
  opacity: 1;
}

.half-modal .mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
}

.half-modal .modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #f4f4f4;
  border-radius: 32rpx 32rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s;
  padding-bottom: env(safe-area-inset-bottom);
}

.half-modal.show .modal-content {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 24rpx;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  text-align: center;
}

.close-btn {
  font-size: 40rpx;
  color: #999;
  padding: 0 10rpx;
  line-height: 1;
}

.modal-body {
  padding: 24rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.confirm-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
}

.confirm-shop {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.check-icon {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-icon.active {
  background: #ff5b55;
  border-color: #ff5b55;
}

.check-icon.active::after {
  content: "";
  width: 16rpx;
  height: 8rpx;
  border-left: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(-45deg) translate(2rpx, -2rpx);
}

.status-tag {
  margin-left: auto;
  font-size: 24rpx;
  color: #ff5b55;
}

.confirm-goods {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.confirm-delivery {
  display: flex;
  align-items: center;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #333;
  margin-bottom: 24rpx;
}

.confirm-delivery .icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}

.confirm-total {
  text-align: right;
  font-size: 26rpx;
  color: #333;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.confirm-total .price-symbol {
  font-weight: 600;
  margin-left: 12rpx;
}

.confirm-total .price-num {
  font-size: 32rpx;
  font-weight: 600;
}

.confirm-tips {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-top: 24rpx;
}

.modal-footer {
  padding: 24rpx 32rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
}

.confirm-btn {
  background: #ff5b55;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
}
