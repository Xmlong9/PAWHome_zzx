.settings-page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom);
}

.group-title {
  font-size: 26rpx;
  color: #666;
  margin: 32rpx 0 16rpx 16rpx;
}

.list-group {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 32rpx;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.list-item:last-child {
  border-bottom: none;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.label {
  font-size: 28rpx;
  color: #333;
}

.item-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.value-text {
  font-size: 26rpx;
  color: #999;
}

.arrow {
  font-size: 32rpx;
  color: #ccc;
}

.btn-wrap {
  margin-top: 60rpx;
  margin-bottom: 40rpx;
}

.logout-btn {
  width: 100% !important;
  height: 88rpx;
  background: #ff9e59;
  color: #111;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}