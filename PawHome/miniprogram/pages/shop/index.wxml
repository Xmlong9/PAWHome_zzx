<view class="shop-page {{showBlob ? 'page-transition' : 'page-hidden'}}" style="padding-top: {{safeTop}}px;">
  <!-- 右上角灰色椭圆背景 -->
  <view class="header-blob" wx:if="{{showBlob}}"></view>

  <view class="shop-top">
    <view class="search-row" bindtap="goSearch">
      <image class="search-bg" src="/assets/images/home/search@1x.png" mode="widthFix"></image>
      <view class="search-placeholder">喵呜~今天要翻些什么家具呢</view>
      <image class="cart-btn" src="/assets/icons/shop/购物车.png" mode="aspectFit" catchtap="goCart"></image>
    </view>

    <view class="entry-grid">
      <block wx:for="{{entries}}" wx:key="id">
        <view class="entry-item" data-url="{{item.url}}" bindtap="tapEntry">
          <image class="entry-icon" src="{{item.icon}}" mode="aspectFit"></image>
          <text>{{item.title}}</text>
        </view>
      </block>
    </view>

    <image class="hero-banner" src="{{banners[0]}}" mode="widthFix" bindtap="openBannerDetail"></image>
  </view>

  <view class="section-title">推荐好物</view>
  <view class="product-grid">
    <block wx:for="{{products}}" wx:key="id">
      <view class="product-card" data-id="{{item.id}}" bindtap="tapProduct">
        <image class="product-img" src="{{item.imageUrl}}" mode="aspectFill"></image>
        <view class="product-name">{{item.name}}</view>
        <view class="product-desc">{{item.desc}}</view>
        <view class="product-bottom">
          <view class="price-wrap">
            <text class="price">¥{{item.price}}</text>
            <text class="market">¥{{item.marketPrice}}</text>
          </view>
          <view class="fav {{item.favorite ? 'active' : ''}}" data-id="{{item.id}}" catchtap="tapFavorite">收藏</view>
        </view>
      </view>
    </block>
  </view>
</view>
