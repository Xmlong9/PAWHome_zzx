<view class="service-page">
  <view class="top-card">
    <image class="top-bg-image" src="/assets/images/shop/问号猫.png" mode="aspectFill"></image>
    <view class="top-content">
      <view class="title">喵！遇到什么问题了吗？让小宠来帮你吧！</view>
      <view class="quick-actions">
        <block wx:for="{{faqs}}" wx:key="id">
          <view class="quick-btn" data-q="{{item.q}}" bindtap="tapFaq">{{item.q}}</view>
        </block>
      </view>
    </view>
  </view>

  <view class="card human-card">
    <view class="human-info">
      <view class="human-title">客服会话</view>
      <view class="human-sub">智能客服：常见问题秒回</view>
      <view class="human-sub">人工客服：稍后由管理端回复</view>
    </view>
    <view class="actions">
      <view class="action smart-btn" bindtap="toSmart">进入智能客服</view>
      <view class="action human-btn" bindtap="toHuman">转人工客服</view>
    </view>
  </view>

  <view class="card contact-card">
    <view class="card-title">联系方式</view>
    <view class="contact-item" bindtap="callNow">
      <text class="icon">📞</text>
      <text class="text">400-888-8888</text>
    </view>
    <view class="contact-item">
      <text class="icon">✉️</text>
      <text class="text">support@petmall.com</text>
    </view>
  </view>

  <view class="card history-card">
    <view class="history-header">
      <view class="card-title">历史会话</view>
      <view class="history-actions">
        <view class="history-action danger" wx:if="{{historyAll.length > 0}}" bindtap="cleanupHistory">清理</view>
        <view class="history-action" wx:if="{{historyAll.length > 5}}" bindtap="toggleHistory">{{showAllHistory ? "收起" : "查看更多"}}</view>
      </view>
    </view>
    <block wx:for="{{history}}" wx:key="id">
      <view class="history-item" data-id="{{item.id}}" data-mode="{{item.mode}}" data-started-at="{{item.startedAt}}" bindtap="openHistory">
        <view class="history-left">
          <view class="history-title">{{item.title}}</view>
          <view class="history-status">{{item.status}}</view>
        </view>
        <view class="history-time">{{item.time}}</view>
      </view>
    </block>
    <view class="history-empty" wx:if="{{!history.length}}">暂无历史会话</view>
  </view>
</view>
