.fav-page {
  min-height: 100vh;
  background: #f4f4f4;
  padding: 24rpx;
  box-sizing: border-box;
}

.post-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.post-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.nickname {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.post-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.text {
  font-size: 28rpx;
  color: #333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.post-image {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
}

.empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding-top: 200rpx;
}