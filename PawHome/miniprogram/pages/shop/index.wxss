.shop-page {
  min-height: 100vh;
  background: #fff;
  padding: 0 24rpx 160rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden; /* 防止背景溢出产生横向滚动条 */
}

/* 右上角灰色椭圆背景 */
.header-blob {
  position: absolute;
  right: -100rpx;
  top: -100rpx;
  width: 480rpx;
  height: 300rpx;
  background: #B3B3B3;
  border-radius: 9999rpx;
  z-index: 0;
  animation: rollFromLeftToRight 0.8s ease-out forwards;
}

.shop-top {
  background: transparent;
  border-radius: 28rpx;
  padding: 20rpx 18rpx 26rpx;
  position: relative;
  overflow: visible;
  z-index: 1; /* 保证内容在背景之上 */
}

.search-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 92rpx;
}

.search-bg {
  flex: 1;
  width: 0;
  transform: scale(1.02);
  transform-origin: left center;
  height: auto;
  display: block;
}

.search-placeholder {
  position: absolute;
  left: 128rpx;
  right: 128rpx;
  top: 50%;
  transform: translateY(-42%);
  font-size: 22rpx;
  color: #666;
}

.cart-btn {
  width: 118rpx;
  height: 118rpx;
  flex: 0 0 118rpx;
}

.entry-grid {
  margin-top: 18rpx;
  position: relative;
  z-index: 1;
  background: #f0c15f;
  border: 4rpx solid #000;
  border-radius: 44rpx;
  box-shadow: 8rpx 8rpx 0 #849c4e;
  padding: 22rpx 10rpx 16rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
}

.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}

.entry-icon {
  width: 86rpx;
  height: 86rpx;
}

.hero-banner {
  margin-top: -10rpx;
  margin-bottom: -30rpx;
  width: calc(100% + 20rpx);
  margin-left: -10rpx;
  display: block;
  position: relative;
  z-index: 1;
}

.section-title {
  margin: 0rpx 4rpx 10rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #111;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.product-card {
  background: #fff;
  border: 4rpx solid #000;
  box-shadow: 6rpx 6rpx 0 rgba(0, 0, 0, 0.08);
  border-radius: 8rpx;
  padding: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.product-img {
  width: 100%;
  height: 250rpx;
  border-radius: 6rpx;
  background: #f6f6f6;
}

.product-name {
  font-size: 28rpx;
  color: #111;
  line-height: 1.3;
}

.product-desc {
  font-size: 22rpx;
  color: #777;
  min-height: 56rpx;
  line-height: 1.4;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.price-wrap {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.price {
  color: #ff8b45;
  font-size: 32rpx;
  font-weight: 700;
}

.market {
  color: #aaa;
  font-size: 22rpx;
  text-decoration: line-through;
}

.fav {
  min-width: 82rpx;
  height: 46rpx;
  border-radius: 23rpx;
  background: #efefef;
  color: #666;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fav.active {
  background: #ffe5e5;
  color: #f44336;
}
