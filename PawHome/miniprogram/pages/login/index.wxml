<view class="wrap">
  <view class="logo">爱宠家</view>
  <view class="form">
    <input class="input" type="text" placeholder="邮箱" value="{{email}}" bindinput="onEmail" />
    <input class="input" type="password" placeholder="密码" value="{{password}}" bindinput="onPassword" />
    <button class="btn primary" bindtap="onLogin" disabled="{{logging}}">登录</button>
    <button class="btn shade" bindtap="onRegister" disabled="{{logging}}">注册</button>
  </view>
  <button class="btn shade" bindtap="onSkip">跳过登录（调试）</button>
</view>
