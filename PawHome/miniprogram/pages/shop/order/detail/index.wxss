.order-detail-page {
  min-height: 100vh;
  background: #f4f4f4;
  padding-bottom: 140rpx;
}

.status-header {
  padding: 40rpx 40rpx 60rpx;
  background: linear-gradient(to bottom, #ff9e59, #f4f4f4);
  color: #fff;
}

.status-title {
  font-size: 40rpx;
  font-weight: 700;
}

.status-desc {
  font-size: 26rpx;
  margin-top: 12rpx;
  opacity: 0.9;
}

.address-card {
  margin: -30rpx 24rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.address-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #fff0e6;
  color: #ff9e59;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.address-info {
  flex: 1;
}

.contact {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
}

.phone {
  font-size: 26rpx;
  color: #666;
}

.detail {
  font-size: 26rpx;
  color: #333;
  margin-top: 8rpx;
  line-height: 1.4;
}

.goods-card {
  background: #fff;
  border-radius: 24rpx;
  margin: 0 24rpx 24rpx;
  padding: 30rpx 24rpx;
}

.shop-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-bottom: 24rpx;
}

.platform-tag {
  font-size: 20rpx;
  color: #fff;
  background: #ff5b55;
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  line-height: 1;
}

.shop-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.goods-list {
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f2f2f2;
}

.goods-item {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.goods-item:last-child {
  margin-bottom: 0;
}

.goods-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #f9f9f9;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  min-width: 0;
}

.goods-name {
  font-size: 26rpx;
  color: #111;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.goods-spec {
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
  background: #f7f8fa;
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.goods-tags {
  margin-top: 12rpx;
}

.tag {
  font-size: 20rpx;
  color: #00b36b;
  border: 1rpx solid rgba(0, 179, 107, 0.3);
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.goods-price-box {
  text-align: right;
  min-width: 100rpx;
}

.goods-price {
  font-size: 26rpx;
  color: #111;
  font-weight: 600;
}

.goods-count {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.fallback-goods {
  font-size: 28rpx;
  color: #333;
  padding: 20rpx 0;
}

.fee-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666;
  margin-top: 24rpx;
}

.total-row {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f2f2f2;
  font-size: 26rpx;
  color: #333;
}

.total-price {
  font-size: 34rpx;
  font-weight: 700;
  color: #ff5b55;
  margin-left: 12rpx;
}

.info-card {
  background: #fff;
  border-radius: 24rpx;
  margin: 0 24rpx 24rpx;
  padding: 30rpx 24rpx;
}

.info-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  position: relative;
}

.info-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: #ff9e59;
  border-radius: 3rpx;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 26rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.label {
  color: #999;
  width: 140rpx;
}

.value {
  color: #333;
  flex: 1;
}

.copy-btn {
  font-size: 22rpx;
  color: #666;
  background: #f4f4f4;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 16rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: #fff;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 0 24rpx;
  gap: 16rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
  padding-bottom: env(safe-area-inset-bottom);
}

.btn {
  height: 64rpx;
  padding: 0 36rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.btn.outline {
  border: 1rpx solid #d9d9d9;
  color: #333;
}

.btn.primary {
  border: 1rpx solid #ff5b55;
  color: #ff5b55;
}

.loading-page {
  padding-top: 200rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}