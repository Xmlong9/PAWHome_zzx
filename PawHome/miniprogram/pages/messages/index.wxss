page {
  height: 100vh;
  width: 100vw;
  background: #fff;
  overflow: hidden;
}

.container {
  height: 100vh;
  width: 100vw;
  background: #fff;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: #fff;
  z-index: 100;
  border-bottom: 1rpx solid #f5f5f5;
}

.nav-content {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  position: relative;
}

.back-btn,
.nav-right {
  width: 88rpx;
  height: 44px;
  display: flex;
  align-items: center;
}

.back-arrow {
  font-size: 36rpx;
  color: #333;
}

.nav-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  pointer-events: none;
}

.tabs {
  height: 80rpx;
  display: flex;
  align-items: center;
  gap: 48rpx;
  padding: 0 24rpx 18rpx;
  box-sizing: border-box;
}

.tab-wrap {
  position: relative;
}

.tab {
  font-size: 30rpx;
  color: #888;
  position: relative;
  padding: 8rpx 0;
}

.tab.active {
  color: #111;
  font-weight: 600;
}

.tab.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -8rpx;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: #111;
  border-radius: 999rpx;
}

.tab-dot {
  position: absolute;
  top: -2rpx;
  right: -14rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff4d4f;
}

.scroll {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.list {
  padding: 8rpx 0;
}

.item {
  display: flex;
  align-items: flex-start;
  padding: 30rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
  border: 1rpx solid #f0f0f0;
}

.mid {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.author-tag {
  font-size: 20rpx;
  color: #999;
  background: #f5f5f5;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.action-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.action-text {
  font-size: 26rpx;
  color: #666;
}

.time {
  font-size: 24rpx;
  color: #999;
}

.comment-text {
  font-size: 28rpx;
  color: #333;
  margin-top: 16rpx;
  line-height: 1.5;
  word-break: break-all;
}

.quote-row {
  display: flex;
  margin-top: 16rpx;
  background: #f9f9f9;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
}

.quote-line {
  width: 4rpx;
  background: #e0e0e0;
  border-radius: 2rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.quote-text {
  font-size: 26rpx;
  color: #888;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.comment-subtabs {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 12rpx 24rpx 6rpx;
}

.subtab {
  position: relative;
  font-size: 28rpx;
  color: #999;
  padding: 10rpx 0;
}

.subtab.active {
  color: #111;
  font-weight: 600;
}

.subtab.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 36rpx;
  height: 6rpx;
  background: #111;
  border-radius: 999rpx;
}

.right-thumb {
  margin-left: 24rpx;
  flex-shrink: 0;
}

.thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  object-fit: cover;
}

.badge {
  min-width: 38rpx;
  height: 38rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}
