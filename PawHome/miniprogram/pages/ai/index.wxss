.ai-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 28rpx 48rpx;
  background: linear-gradient(180deg, #fff9f2 0%, #ffffff 42%, #f7f8fb 100%);
}

.hero-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 24rpx;
  padding: 56rpx 40rpx;
  border-radius: 32rpx;
  background: linear-gradient(180deg, #fff4e5 0%, #ffffff 100%);
  box-shadow: 0 20rpx 48rpx rgba(161, 125, 84, 0.14);
}

.hero-icon {
  width: 124rpx;
  height: 124rpx;
  margin-bottom: 20rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #2c241d;
}

.hero-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #78624d;
  text-align: center;
}

.section-title {
  margin: 40rpx 8rpx 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #3c3127;
}

.highlight-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.highlight-card {
  padding: 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(36, 29, 23, 0.06);
}

.highlight-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2f261f;
}

.highlight-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #78624d;
}

.primary-btn {
  margin-top: 36rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffc300 0%, #ff9f43 100%);
  color: #2a2119;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 18rpx 40rpx rgba(255, 195, 0, 0.28);
}
