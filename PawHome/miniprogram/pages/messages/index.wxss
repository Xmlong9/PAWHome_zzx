page {
  height: 100vh;
  width: 100vw;
  background: #fff;
  overflow: hidden;
}

.container {
  height: 100vh;
  width: 100vw;
  background: #fff;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: #fff;
  z-index: 100;
  border-bottom: 1rpx solid #f5f5f5;
}

.nav-content {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  position: relative;
}

.back-btn,
.nav-right {
  width: 88rpx;
  height: 44px;
  display: flex;
  align-items: center;
}

.back-arrow {
  font-size: 36rpx;
  color: #333;
}

.nav-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  pointer-events: none;
}

.tabs {
  height: 80rpx;
  display: flex;
  align-items: center;
  gap: 48rpx;
  padding: 0 24rpx 18rpx;
  box-sizing: border-box;
}

.tab-wrap {
  position: relative;
}

.tab {
  font-size: 30rpx;
  color: #888;
  position: relative;
  padding: 8rpx 0;
}

.tab.active {
  color: #111;
  font-weight: 600;
}

.tab.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -8rpx;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: #111;
  border-radius: 999rpx;
}

.tab-dot {
  position: absolute;
  top: -2rpx;
  right: -14rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff4d4f;
}

.scroll {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.list {
  padding: 8rpx 0;
}

.item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
  border: 1rpx solid #f0f0f0;
}

.mid {
  flex: 1;
  min-width: 0;
}

.row1 {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.time {
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
}

.row2 {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row3 {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.thumb {
  width: 92rpx;
  height: 92rpx;
  border-radius: 12rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}

.badge {
  min-width: 38rpx;
  height: 38rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}
