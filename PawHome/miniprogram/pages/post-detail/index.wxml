<view class="container">
  <view class="nav-bar" style="padding-top: {{safeAreaTop}}px">
    <view class="nav-inner">
      <view class="nav-left" catchtap="goBack">
        <view class="back-icon"></view>
      </view>
      <view class="nav-tabs">
        <view class="tab-item {{currentTab === 'content' ? 'active' : ''}}" bindtap="onTabChange" data-tab="content">
          正文
          <view class="tab-line" wx:if="{{currentTab === 'content'}}"></view>
        </view>
        <view class="tab-item {{currentTab === 'comments' ? 'active' : ''}}" bindtap="onTabChange" data-tab="comments">
          评论
          <view class="tab-line" wx:if="{{currentTab === 'comments'}}"></view>
        </view>
      </view>
      <view class="nav-right"></view>
    </view>
  </view>

  <!-- Scroll Area -->
  <!-- 使用绝对定位和 padding-top 来避免 margin 塌陷或计算误差 -->
  <scroll-view scroll-y class="scroll-area" enable-flex style="padding-top: {{safeAreaTop + 44}}px;">
    
    <view class="tab-content" hidden="{{currentTab !== 'content'}}">
      <view class="post-detail" wx:if="{{post}}">
        <view class="media-carousel" wx:if="{{post.videoUrl}}" style="margin-top: 0;">
          <video class="swiper-img" src="{{post.videoUrl}}" poster="{{post.images[0]}}" controls objectFit="contain"></video>
        </view>

        <view class="media-carousel" wx:if="{{!post.videoUrl && post.images && post.images.length > 0}}" style="margin-top: 0;background-color: {{mediaBgColor}};">
          <swiper class="swiper" bindchange="onSwiperChange" style="height: {{mediaHeight}}px;">
            <block wx:for="{{post.images}}" wx:key="*this">
              <swiper-item>
                <image class="swiper-img" src="{{item}}" mode="aspectFit" bindtap="previewImage" data-current="{{item}}" data-index="{{index}}" bindload="onImageLoad"></image>
              </swiper-item>
            </block>
          </swiper>
          <view class="image-indicator">{{swiperCurrent + 1}}/{{post.images.length}}</view>
        </view>

        <view class="post-body">
          <view class="author-header">
            <image class="avatar" src="{{post.user.avatarUrl}}" mode="aspectFill" catchtap="goUserProfile" data-userid="{{post.userId}}"></image>
            <view class="author-info" catchtap="goUserProfile" data-userid="{{post.userId}}">
              <view class="nickname">{{post.user.nickname}}</view>
            </view>
            <view class="follow-btn {{post.isFollowed ? 'followed' : ''}}" bindtap="onFollowTap" wx:if="{{!isSelfPost}}">
              {{post.isFollowed ? '已关注' : '+ 关注'}}
            </view>
            <view class="manage-btn" bindtap="onPostActionTap">
              <image class="a-icon" src="/assets/icons/community/ellipsis.svg" mode="aspectFit" style="width: 32rpx; height: 32rpx;"></image>
            </view>
          </view>

          <view class="content-text">
            <view class="post-title" wx:if="{{post.title}}">{{post.title}}</view>
            <text class="text" user-select>{{post.content}}</text>
            <view class="post-time" wx:if="{{post.location}}">📍 {{post.location}}</view>
            <view class="post-time">{{post.timeAgo}}</view>
            <view class="post-time" wx:if="{{post.viewCount !== undefined}}">👁 {{post.viewCount}}</view>
          </view>
        </view>
        
        <view class="divider"></view>

        <view class="comments-section">
          <view class="section-title">全部评论 ({{totalComments}})</view>
          <template is="commentList" data="{{comments, loadingComments}}"/>
        </view>
      </view>
    </view>

    <view class="tab-content" hidden="{{currentTab !== 'comments'}}">
      <view class="comments-section" style="padding-top: 20rpx;">
        <template is="commentList" data="{{comments, loadingComments}}"/>
      </view>
    </view>

  </scroll-view>

  <view class="footer-bar" style="padding-bottom: {{safeAreaBottom}}px">
    <view class="input-wrapper">
      <input class="input-field" 
             placeholder="{{replyTo ? '回复 ' + replyTo.user.nickname + '：' : '说点什么...'}}" 
             placeholder-style="color:#999" 
             confirm-type="send"
             value="{{inputValue}}"
             focus="{{inputFocus}}"
             bindinput="onInput"
             bindconfirm="onSend"
             bindblur="onInputBlur"
      />
    </view>
    <view class="action-icons">
      <view class="icon-btn" bindtap="onLikePostTap">
        <image class="icon-img" src="/assets/icons/community/{{post.isLiked ? 'heart-filled' : 'heart'}}.svg" mode="aspectFit"></image>
        <text class="icon-text">{{post.likeCount || 0}}</text>
      </view>
      <view class="icon-btn" bindtap="onFavoriteTap">
        <image class="icon-img" src="/assets/icons/community/{{post.isFavorited ? 'bookmark-filled' : 'bookmark'}}.svg" mode="aspectFit"></image>
        <text class="icon-text">{{post.favoriteCount || 0}}</text>
      </view>
      <view class="icon-btn">
        <image class="icon-img" src="/assets/icons/community/comment.svg" mode="aspectFit"></image>
        <text class="icon-text">{{post.commentCount || 0}}</text>
      </view>
    </view>
  </view>

  <view class="sheet-mask" wx:if="{{showActionPanel}}" bindtap="closeActionPanel"></view>
  <view class="sheet-panel {{showActionPanel ? 'show' : ''}}" wx:if="{{showActionPanel}}" catchtap="stopPanelTap">
    <view class="sheet-head">
      <text class="sheet-title">分享至</text>
      <text class="sheet-close" bindtap="closeActionPanel">✕</text>
    </view>

    <view class="sheet-block">
      <scroll-view class="share-user-scroll" scroll-x enable-flex>
        <view class="share-users">
          <block wx:for="{{shareTargets}}" wx:key="id">
            <view
              class="share-user {{item.selected?'selected':''}}"
              bindtap="onToggleShareTarget"
              data-id="{{item.id}}"
            >
              <view class="avatar-wrap">
                <image class="share-user-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
                <view class="check-icon" wx:if="{{item.selected}}">
                  <view class="check-icon-inner">
                    <text class="check-icon-mark">✓</text>
                  </view>
                </view>
                <view class="uncheck-icon" wx:else>
                  <view class="uncheck-circle"></view>
                </view>
              </view>
              <text class="share-user-name">{{item.nickname}}</text>
              <text class="share-user-status" wx:if="{{item.group==='mutual'}}">互关好友</text>
              <text class="share-user-status" wx:elif="{{item.group==='following'}}">关注</text>
              <text class="share-user-status" wx:else>粉丝</text>
            </view>
          </block>
        </view>
      </scroll-view>
    </view>

    <view class="sheet-block action-block">
      <scroll-view class="action-scroll" scroll-x enable-flex>
        <view class="action-list">
          <button class="action-btn" open-type="share" bindtap="onShareToWxFriend">
            <view class="action-icon-wrap wechat">
              <image class="a-icon" src="/assets/icons/community/wechat.svg" mode="aspectFit"></image>
            </view>
            <text class="action-text">微信好友</text>
          </button>
          <view class="action-btn" bindtap="onShareToTimeline">
            <view class="action-icon-wrap timeline">
              <image class="a-icon" src="/assets/icons/community/timeline.svg" mode="aspectFit"></image>
            </view>
            <text class="action-text">朋友圈</text>
          </view>
          <view class="action-btn" bindtap="onCopyShareLink">
            <view class="action-icon-wrap default">
              <image class="a-icon" src="/assets/icons/community/link.svg" mode="aspectFit"></image>
            </view>
            <text class="action-text">复制链接</text>
          </view>
          <view class="action-btn" bindtap="onSaveImagesTap">
            <view class="action-icon-wrap default">
              <image class="a-icon" src="/assets/icons/community/download.svg" mode="aspectFit"></image>
            </view>
            <text class="action-text">保存图片</text>
          </view>
          <view class="action-btn" bindtap="onEditPostTap" wx:if="{{isSelfPost}}">
            <view class="action-icon-wrap default">
              <image class="a-icon" src="/assets/icons/community/edit.svg" mode="aspectFit"></image>
            </view>
            <text class="action-text">编辑帖子</text>
          </view>
          <view class="action-btn" bindtap="onPinPostTap" wx:if="{{isSelfPost}}">
            <view class="action-icon-wrap default">
              <image class="a-icon" src="/assets/icons/community/pin.svg" mode="aspectFit"></image>
            </view>
            <text class="action-text">{{post.isPinned ? '取消置顶' : '置顶帖子'}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- Bottom Actions -->
    <view class="bottom-actions" wx:if="{{selectedShareIds.length > 0}}">
      <view class="input-fake">
        <text class="placeholder">跟朋友说点什么吧.....</text>
      </view>
      <view class="send-btns">
        <view class="btn-single" bindtap="onSendInternalShare">发送</view>
      </view>
    </view>
    
    <view class="cancel-action" wx:if="{{selectedShareIds.length === 0}}">
      <view class="cancel-btn" bindtap="closeActionPanel">取消</view>
    </view>
  </view>
</view>

<template name="commentList">
  <view class="comment-list">
    <block wx:for="{{comments}}" wx:key="id">
      <view class="comment-item">
        <image class="c-avatar" src="{{item.user.avatarUrl}}" mode="aspectFill" catchtap="goUserProfile" data-userid="{{item.userId}}"></image>
        <view class="c-right">
          <view class="c-header" catchtap="goUserProfile" data-userid="{{item.userId}}">
            <text class="c-nickname">{{item.user.nickname}}</text>
          </view>
          <view class="c-content" bindtap="onReplyTap" data-item="{{item}}">
            <text class="pinned-tag" wx:if="{{item.isPinned}}">置顶</text>
            <text wx:if="{{item.replyTo}}">回复 <text class="reply-target">@{{item.replyTo.nickname}}</text>：</text>{{item.content}}
          </view>
          <view class="c-footer">
            <text class="c-time">{{item.timeAgo}}</text>
            <view class="c-actions">
              <view class="c-like" bindtap="onLikeCommentTap" data-index="{{index}}" data-id="{{item.id}}">
                <image class="icon-img-sm" src="/assets/icons/community/{{item.isLiked ? 'heart-filled' : 'heart'}}.svg" mode="aspectFit"></image>
                <text wx:if="{{item.likeCount > 0}}">{{item.likeCount}}</text>
              </view>
              <text class="c-op" bindtap="onDeleteCommentTap" data-id="{{item.id}}" data-item="{{item}}" wx:if="{{item.canDelete}}">删除</text>
              <text class="c-op" bindtap="onPinCommentTap" data-id="{{item.id}}" data-ispinned="{{item.isPinned}}" wx:if="{{isSelfPost}}">{{item.isPinned ? '取消置顶' : '置顶'}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>
    <view class="no-comments" wx:if="{{comments.length === 0}}">暂无评论，快来抢沙发吧~</view>
    <view class="loading-more" wx:if="{{loadingComments}}">加载中...</view>
  </view>
</template>
