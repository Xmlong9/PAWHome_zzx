<view class="checkout-page" wx:if="{{preview}}">
  <!-- Address Section -->
  <view class="address-section" bindtap="goChooseAddress">
    <view class="address-empty" wx:if="{{!address}}">
      <view class="address-empty-text">
        <view class="address-empty-title">请选择收货地址</view>
        <view class="address-empty-desc">支持地图选点与默认地址</view>
      </view>
      <view class="arrow-right">›</view>
    </view>
    <block wx:else>
    <view class="address-left">
      <view class="user-info">
        <text class="user-name">{{address.name}}</text>
        <text class="user-phone">{{address.phone}}</text>
      </view>
      <view class="address-detail-wrap">
        <text class="location-icon">📍</text>
        <text class="address-detail">{{address.province}}{{address.city}}{{address.district}}{{address.detail}}</text>
      </view>
    </view>
    <view class="arrow-right">›</view>
    </block>
  </view>

  <!-- Goods List -->
  <view class="card goods-card">
    <view class="title">商品清单</view>
    <block wx:for="{{preview.items}}" wx:key="product.id">
      <view class="item-row">
        <image class="thumb" src="{{item.product.imageUrl}}" mode="aspectFill"></image>
        <view class="meta">
          <view class="name">{{item.product.name}}</view>
          <view class="spec">规格：{{item.product.specs[0] || '默认'}}</view>
          <view class="price-row-item">
            <text class="price">¥ {{item.product.price}}</text>
            <text class="count">x{{item.count}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- Coupons & Delivery -->
  <view class="card option-card">
    <view class="option-row">
      <text class="option-label">优惠券</text>
      <view class="option-value">
        <text class="value-text">2张可用</text>
        <text class="arrow-right">›</text>
      </view>
    </view>
    <view class="divider"></view>
    <view class="option-row">
      <text class="option-label">配送方式</text>
      <view class="option-value">
        <text class="value-text">快递配送</text>
        <text class="arrow-right">›</text>
      </view>
    </view>
  </view>

  <!-- Payment Method -->
  <view class="card payment-card">
    <view class="title">支付方式</view>
    <view class="pay-options">
      <view class="pay-item" data-value="wx" bindtap="choosePayType">
        <view class="pay-left">
          <image class="pay-icon" src="data:image/svg+xml,%3Csvg viewBox='64 64 896 896' focusable='false' data-icon='wechat' width='1em' height='1em' fill='%2307c160' aria-hidden='true' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M685.2 411.3c-1.3 0-2.5.1-3.8.1-17.7 0-35.1-2.2-51.9-6.3a241.16 241.16 0 00-60.6-258C526.4 105.7 459 81.9 385 81.9c-73.9 0-141.3 23.8-183.8 65.2C158.6 188.6 136 241.7 136 301c0 62.5 25.5 118 71.9 156.4 1.7 1.4 2.8 3.5 3.1 5.7.3 2.2-.4 4.4-1.8 6L185 500c-1.4 1.6-1.5 3.9-.3 5.7s3.3 2.4 5.3 1.8l63-18.4c1.9-.6 4-.3 5.6.8 39.5 25.4 86.8 39.5 136.2 39.5 4.3 0 8.6-.1 12.8-.3-19.4 34.6-30.4 74.3-30.4 116.7 0 60.1 23 113.8 64.9 150.7 41.9 36.9 98.4 57.3 159.2 57.3 46 0 89.9-12.7 127.3-35.8l56.8 16.6c2 .6 4.1.1 5.3-1.8s1.1-4.1-.3-5.7l-21.8-27.9c-1.4-1.6-2-3.8-1.8-6 .3-2.2 1.4-4.2 3.1-5.7 41.9-34.7 64.9-82.6 64.9-138.8 0-112.5-98.5-204-220-204zM321 282.8c18.8 0 34 15.2 34 34s-15.2 34-34 34-34-15.2-34-34 15.2-34 34-34zm134.4 68c-18.8 0-34-15.2-34-34s15.2-34 34-34 34 15.2 34 34-15.2 34-34 34zm129.2 188.8c14.1 0 25.6 11.5 25.6 25.6s-11.5 25.6-25.6 25.6-25.6-11.5-25.6-25.6 11.5-25.6 25.6-25.6zm106.8 51.2c-14.1 0-25.6-11.5-25.6-25.6s11.5-25.6 25.6-25.6 25.6 11.5 25.6 25.6-11.5 25.6-25.6 25.6z'%3E%3C/path%3E%3C/svg%3E" mode="aspectFit"></image>
          <text class="pay-name">微信支付</text>
        </view>
        <view class="radio-icon {{payType==='wx' ? 'active' : ''}}"></view>
      </view>
      <view class="divider"></view>
      <view class="pay-item" data-value="alipay" bindtap="choosePayType">
        <view class="pay-left">
          <image class="pay-icon" src="data:image/svg+xml,%3Csvg viewBox='64 64 896 896' focusable='false' data-icon='alipay' width='1em' height='1em' fill='%231677ff' aria-hidden='true' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M880 112H144c-17.7 0-32 14.3-32 32v736c0 17.7 14.3 32 32 32h736c17.7 0 32-14.3 32-32V144c0-17.7-14.3-32-32-32zm-289.4 650.5c-44.2 34.6-113.4 60.5-226.7 60.5-121 0-213.1-38.9-213.1-125.3 0-82.1 82.1-118.8 155.5-131.8 116.6-19.4 187.9-19.4 220.3-21.6 0-34.6-6.5-92.9-97.2-92.9-64.8 0-108 23.8-125.3 36.7l-28.1-64.8c28.1-23.8 88.6-47.5 170.6-47.5 86.4 0 157.7 34.6 157.7 142.6 0 15.1-2.2 43.2-4.3 75.6 47.5-30.2 90.7-77.8 116.6-123.1H507.5v-71.3h129.6v-56.2h73.4v56.2h159.8v71.3H723.5c-25.9 49.7-71.3 97.2-118.8 129.6 41 28.1 112.3 54 185.8 54l-38.9 73.4c-62.6-10.8-120.9-41-161-75.6zM286 636.5c-41 10.8-82.1 28.1-82.1 66.9 0 45.4 51.8 60.5 131.8 60.5 82.1 0 144.7-25.9 177.1-47.5-6.5-62.6-6.5-92.9-6.5-92.9-38.9 2.2-118.8 4.3-220.3 13z'%3E%3C/path%3E%3C/svg%3E" mode="aspectFit"></image>
          <text class="pay-name">支付宝</text>
        </view>
        <view class="radio-icon {{payType==='alipay' ? 'active' : ''}}"></view>
      </view>
    </view>
  </view>

  <!-- Price Details -->
  <view class="card price-detail-card">
    <view class="detail-row"><text class="detail-label">商品金额</text><text class="detail-value">¥{{preview.goodsAmount}}</text></view>
    <view class="detail-row"><text class="detail-label">运费</text><text class="detail-value">¥{{preview.freight}}</text></view>
    <view class="detail-row"><text class="detail-label">优惠券</text><text class="detail-value highlight">-¥{{preview.discount}}</text></view>
  </view>

  <!-- Submit Bar -->
  <view class="submit-bar">
    <view class="total-wrap">
      <text class="total-label">实付金额：</text>
      <text class="total-price">¥{{preview.payableAmount}}</text>
    </view>
    <view class="submit-btn" bindtap="createOrder">提交订单</view>
  </view>
</view>
