.relations-page {
  min-height: 100vh;
  background: #fff;
}

.tabs {
  height: 88rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #f2f2f2;
}

.tab {
  flex: 1;
  text-align: center;
  color: #999;
  font-size: 30rpx;
  line-height: 88rpx;
}

.tab.active {
  color: #111;
  font-weight: 600;
}

.list {
  height: calc(100vh - 88rpx);
}

.item {
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f7f7f7;
}

.left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #f5f5f5;
}

.meta {
  margin-left: 20rpx;
  min-width: 0;
}

.name {
  font-size: 30rpx;
  color: #222;
}

.sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #999;
}

.right {
  display: flex;
  align-items: center;
}

.btn {
  height: 56rpx;
  min-width: 112rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 28rpx;
  font-size: 24rpx;
  margin-left: 12rpx;
}

.btn.chat {
  color: #333;
  background: #f5f5f5;
}

.btn.follow {
  color: #fff;
  background: #ff8a00;
}

.btn.follow.following {
  color: #333;
  background: #efefef;
}

.empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 100rpx 0;
}
