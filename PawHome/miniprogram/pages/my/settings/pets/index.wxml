<view class="ui-page ui-page--with-bottom">
  <view class="ui-hero">
    <text class="ui-title">宠物档案</text>
    <text class="ui-subtitle">记录宠物信息，购物与服务更匹配</text>
  </view>

  <scroll-view scroll-y class="ui-list" wx:if="{{pets.length > 0}}">
    <view class="ui-item" wx:for="{{pets}}" wx:key="id" data-id="{{item.id}}" bindtap="goPetDetail">
      <image class="ui-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
      <view class="ui-item-main">
        <view class="ui-item-title-row">
          <text class="ui-item-title">{{item.name}}</text>
          <text class="ui-chip {{item.gender === '帅哥' ? 'ui-chip--boy' : 'ui-chip--girl'}}">{{item.gender}}</text>
        </view>
        <view class="ui-tags">
          <text class="ui-tag">{{item.weight}}</text>
          <text class="ui-tag">绝育: {{item.isSterilized}}</text>
          <text class="ui-tag">生日: {{item.birthday}}</text>
        </view>
      </view>
      <view class="ui-chevron"></view>
    </view>
  </scroll-view>

  <view class="ui-empty" wx:else>
    <view class="ui-empty-illus"></view>
    <text class="ui-empty-title">暂无宠物档案</text>
    <text class="ui-empty-desc">添加一只宠物，后续购买更方便</text>
  </view>

  <view class="ui-bottom-bar">
    <button class="ui-btn-primary" bindtap="onAdd">添加宠物</button>
  </view>
</view>
