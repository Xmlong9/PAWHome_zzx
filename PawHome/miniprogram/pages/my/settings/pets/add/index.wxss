page {
  background: #ffffff;
}

.avatar-section {
  display: flex;
  justify-content: center;
  padding: 60rpx 0 40rpx;
}

.avatar-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.camera-icon {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  width: 56rpx;
  height: 56rpx;
  background: #111;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
}

.camera-icon-inner {
  font-size: 28rpx;
  color: #fff;
}

.form-section {
  padding: 0 40rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: #64748b;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-input-wrap, .form-picker-wrap {
  height: 96rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  justify-content: space-between;
}

.form-input {
  flex: 1;
  height: 100%;
  font-size: 30rpx;
  color: #0f172a;
}

.form-picker-text {
  flex: 1;
  font-size: 30rpx;
  color: #0f172a;
}

.form-placeholder {
  color: #94a3b8;
}

.form-arrow {
  font-size: 32rpx;
  color: #94a3b8;
  margin-left: 16rpx;
  transform: rotate(90deg);
}

.form-icon {
  font-size: 32rpx;
  color: #94a3b8;
  margin-left: 16rpx;
}

.gender-group, .radio-group {
  display: flex;
  gap: 24rpx;
}

.gender-btn, .radio-btn {
  flex: 1;
  height: 96rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #475569;
  font-weight: 500;
  transition: all 0.2s;
}

.gender-icon {
  margin-right: 8rpx;
  font-size: 32rpx;
}

.gender-btn.active, .radio-btn.active {
  background: #ff9e59;
  color: #fff;
  box-shadow: 0 8rpx 16rpx rgba(255, 158, 89, 0.2);
}

/* 底部按钮适配在 ui-bottom-bar 中全局样式，此处无需重复 */
