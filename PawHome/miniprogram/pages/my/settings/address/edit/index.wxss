page {
  background: #f7f8fa;
}

.map-card {
  position: relative;
  padding: 0;
  overflow: hidden;
}

.addr-map {
  width: 100%;
  height: 320rpx;
}

.map-actions {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 20rpx;
  display: flex;
  justify-content: flex-end;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0), rgba(15, 23, 42, 0.08));
  box-sizing: border-box;
}

.form-card {
  margin-top: 20rpx;
}

.region-text {
  flex: 1;
  font-size: 30rpx;
  color: #0f172a;
}

.region-text.placeholder {
  color: #94a3b8;
}

.ui-input-wrap.multiline {
  align-items: flex-start;
  height: auto;
  padding: 18rpx 20rpx;
}

.ui-input.textarea {
  min-height: 120rpx;
  height: 120rpx;
  line-height: 1.6;
}

.default-row {
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.default-left {
  min-width: 0;
}

.ui-btn-danger {
  width: 100% !important;
  height: 88rpx;
  border-radius: 44rpx;
  background: rgba(239, 68, 68, 0.10);
  color: #ef4444;
  font-size: 30rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(239, 68, 68, 0.18);
}

.ui-btn-danger::after {
  border: none;
}

.ui-btn-danger:active {
  opacity: 0.9;
  transform: scale(0.99);
}
