/* Page Container */
.community {
  min-height: 100vh;
  background-color: #f8f8f8;
  padding-bottom: 40rpx;
}

/* Header */
.header {
  background: #fff;
  border-bottom-left-radius: 60rpx;
  border-bottom-right-radius: 60rpx;
  padding: 20rpx 32rpx 40rpx 32rpx;
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  overflow: visible; /* Allow blob to overflow */
}

.header-blob {
  position: absolute;
  left: -80rpx;
  top: -120rpx;
  width: 480rpx;
  height: 300rpx;
  background: #FF9E59;
  border-radius: 9999rpx;
  z-index: 0;
  animation: rollFromRightToLeft 0.8s ease-out forwards;
}

.header-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 2;
  margin-top: 20rpx;
  gap: 20rpx;
}

/* Mail Icon (CSS Only) */
.mail-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.mail-svg {
  width: 56rpx;
  height: 56rpx;
}

.mail-dot {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff4d4f;
}

/* Search Bar */
.search {
  position: relative;
  flex: 1;
  height: 56rpx; /* 缩小高度，与主页保持一致 */
  display: flex;
  align-items: center;
}

.search-bg {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 100%;
  height: 100%;
  z-index: 1;
}

.search-placeholder {
  position: absolute;
  left: 100rpx; /* 向右移一点 (原来是80rpx) */
  right: 40rpx;
  top: 50%;
  transform: translateY(-30%); /* 向下移一点 (原来是-48%) */
  font-size: 24rpx;
  color: #666;
  text-align: left;
  z-index: 2;
}

/* Tags Filter */
.tags-scroll {
  white-space: nowrap;
  padding: 24rpx 0;
  background: transparent;
  z-index: 5;
  position: relative;
}

.tags-container {
  display: flex;
  padding: 0 32rpx;
  gap: 24rpx;
}

.tag {
  display: inline-block;
  padding: 12rpx 32rpx;
  background: #fff;
  color: #666;
  font-size: 28rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
  font-weight: 500;
  transition: all 0.2s ease;
}

.tag.active {
  background: #FF9E59;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(255, 158, 89, 0.4);
}

/* Post List */
.post-list {
  padding: 0 32rpx;
}

.post-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04);
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 2rpx solid #f0f0f0;
}

.user-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.nickname {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.time {
  font-size: 24rpx;
  color: #999;
}

.meta-row {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.views {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
}

.views-icon {
  width: 28rpx;
  height: 28rpx;
}

.views-text {
  font-size: 24rpx;
  color: #999;
}

.post-content {
  margin-bottom: 24rpx;
}

.text-content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.text-content.single-line {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
  text-overflow: ellipsis;
}

.text-content.multi-line {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  text-overflow: ellipsis;
}

.media-content {
  width: 100%;
  height: 400rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.post-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.post-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.stats {
  display: flex;
  gap: 40rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #666;
}

/* CSS Icons for stats */
.icon-img {
  width: 36rpx;
  height: 36rpx;
}

/* FAB */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  background: #000;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.2);
  z-index: 100;
}

.fab-icon {
  color: #fff;
  font-size: 60rpx;
  font-weight: 300;
  margin-top: -8rpx;
}

.loading, .no-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}
