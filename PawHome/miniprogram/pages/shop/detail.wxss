.detail-page {
  min-height: 100vh;
  background: #f4f4f4;
  padding-bottom: 240rpx;
}

.nav-shell {
  position: sticky;
  top: 0;
  z-index: 20;
  background: #fff;
}

.nav-bar {
  height: 88rpx;
  padding: 0 22rpx 0 18rpx;
  display: flex;
  align-items: center;
}

.nav-back {
  width: 80rpx;
  height: 80rpx;
  font-size: 50rpx;
  color: #111;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding-left: 10rpx;
  margin-left: -10rpx;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #1e1e1e;
  margin-left: 60rpx;
}

.nav-actions {
  min-width: 140rpx;
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
}

.nav-action {
  min-width: 56rpx;
  height: 56rpx;
  padding: 0 14rpx;
  border-radius: 28rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.08);
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #111;
  font-size: 20rpx;
  box-sizing: border-box;
}

.nav-action-mini {
  min-width: 56rpx;
  padding: 0;
  font-size: 18rpx;
}

.product-image {
  width: 100%;
  height: 680rpx;
  display: block;
  background: #f2d116;
}

.content-sheet {
  position: relative;
  z-index: 2;
  margin-top: -24rpx;
  padding: 0 18rpx 24rpx;
  border-radius: 36rpx 36rpx 0 0;
}

.card {
  background: #fff;
  border-radius: 26rpx;
  padding: 28rpx 26rpx;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.04);
}

.info-card {
  padding-top: 26rpx;
}

.price-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.price-wrap {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.price {
  font-size: 52rpx;
  line-height: 1;
  font-weight: 700;
  color: #ff5c4d;
}

.market {
  font-size: 28rpx;
  color: #b9b9b9;
  text-decoration: line-through;
}

.fav {
  margin-left: auto;
  min-width: 108rpx;
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  color: #7f7f7f;
  font-size: 26rpx;
  box-sizing: border-box;
}

.fav.active {
  background: #ffe9e8;
  color: #ff7a73;
}

.name {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: #171717;
  font-weight: 700;
}

.desc {
  margin-top: 12rpx;
  font-size: 18rpx;
  line-height: 1.5;
  color: #8f8f8f;
}

.meta-row {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 16rpx;
  color: #b0b0b0;
}

.compact-card,
.tabs-card,
.card + .card {
  margin-top: 18rpx;
}

.row-item {
  display: flex;
  align-items: center;
  min-height: 72rpx;
}

.row-item-count {
  margin-top: 12rpx;
}

.row-label {
  width: 88rpx;
  color: #7f7f7f;
  font-size: 26rpx;
}

.row-value {
  flex: 1;
  color: #1e1e1e;
  font-size: 28rpx;
  text-align: right;
  padding-right: 12rpx;
}

.row-arrow {
  color: #a7a7a7;
  font-size: 32rpx;
  line-height: 1;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #252525;
}

.spec-list {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.spec-item {
  min-width: 146rpx;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  background: #f1f1f1;
  color: #8c8c8c;
  box-sizing: border-box;
}

.spec-item.active {
  background: #ffe8e6;
  color: #ff7a73;
}

.count-row {
  margin-top: 18rpx;
}

.count-box {
  width: 180rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 14rpx;
  box-sizing: border-box;
}

.op {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #666;
  font-size: 24rpx;
  font-weight: 600;
}

.num {
  font-size: 30rpx;
  color: #1e1e1e;
  font-weight: 500;
}

.tabs-card {
  padding-top: 10rpx;
}

.tabs {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12rpx;
  border-bottom: 2rpx solid #ececec;
}

.tab-item {
  position: relative;
  padding: 22rpx 0 18rpx;
  color: #7f7f7f;
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tab-item.active {
  color: #222;
  font-weight: 600;
}

.tab-line {
  margin-top: 14rpx;
  width: 100%;
  height: 4rpx;
  border-radius: 999rpx;
  background: #1f1f1f;
}

.shipping-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 28rpx 8rpx 18rpx;
  color: #444;
  font-size: 24rpx;
}

.shipping-icon {
  font-size: 28rpx;
}

.shipping-text {
  flex: 1;
}

.section-card {
  margin-top: 0;
  padding: 24rpx;
  background: #f8f8f8;
  box-shadow: none;
}

.detail-line {
  margin-top: 18rpx;
  display: flex;
  align-items: flex-start;
  font-size: 24rpx;
  line-height: 1.6;
}

.detail-label {
  color: #7c7c7c;
}

.detail-value {
  color: #444;
}

.review-score {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f1f1f;
}

.review-tags {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.review-tag {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #fff0ef;
  color: #ff7a73;
  font-size: 24rpx;
}

.review-note {
  margin-top: 22rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #666;
}

.qa-item + .qa-item {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #ececec;
}

.qa-q {
  font-size: 26rpx;
  line-height: 1.6;
  color: #222;
  font-weight: 600;
}

.qa-a {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #666;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  padding: 12rpx 16rpx 0;
  background: #fff;
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-sizing: border-box;
  box-shadow: 0 -10rpx 24rpx rgba(0, 0, 0, 0.04);
}

.tool-group {
  width: 212rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.tool-item {
  width: 64rpx;
  min-height: 88rpx;
  padding: 10rpx 8rpx 8rpx;
  border-radius: 18rpx;
  background: #f7f7f7;
  border: 1rpx solid #ececec;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  box-sizing: border-box;
}

.tool-icon {
  width: 30rpx;
  height: 30rpx;
  display: block;
}

.tool-text {
  font-size: 20rpx;
  color: #595959;
  line-height: 1;
}

.tool-text.active {
  color: #ff6b61;
}

.action-group {
  flex: 1;
  display: flex;
  gap: 14rpx;
}

.add,
.buy {
  height: 82rpx;
  border-radius: 41rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  box-sizing: border-box;
}

.add {
  flex: 1;
  background: #f4cf57;
  color: #6c5600;
}

.buy {
  flex: 1;
  background: #ff6c6a;
  color: #fff;
}

.state-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 28rpx;
}
