<view class="ui-page ui-page--with-bottom">
  <view class="ui-hero">
    <text class="ui-title">{{id ? '编辑收货地址' : '新增收货地址'}}</text>
    <text class="ui-subtitle">支持地图选点，配送更精准</text>
  </view>

  <view class="ui-card map-card">
    <map
      class="addr-map"
      latitude="{{mapLatitude}}"
      longitude="{{mapLongitude}}"
      scale="16"
      markers="{{mapMarkers}}"
    ></map>
    <view class="map-actions">
      <view class="ui-btn-ghost" bindtap="pickLocation">地图选点</view>
    </view>
  </view>

  <view class="ui-card form-card">
    <view class="ui-field">
      <text class="ui-label">收货人</text>
      <view class="ui-input-wrap">
        <input class="ui-input" value="{{name}}" placeholder="请输入姓名" bindinput="onName" />
      </view>
    </view>

    <view class="ui-field">
      <text class="ui-label">手机号</text>
      <view class="ui-input-wrap">
        <input class="ui-input" value="{{phone}}" placeholder="请输入手机号" type="number" maxlength="11" bindinput="onPhone" />
      </view>
    </view>

    <view class="ui-field">
      <text class="ui-label">所在地区</text>
      <picker mode="region" value="{{region}}" bindchange="onRegionChange">
        <view class="ui-input-wrap">
          <text class="region-text {{regionText ? '' : 'placeholder'}}">{{regionText || '请选择省市区'}}</text>
          <view class="ui-chevron"></view>
        </view>
      </picker>
    </view>

    <view class="ui-field">
      <text class="ui-label">详细地址</text>
      <view class="ui-input-wrap multiline">
        <textarea class="ui-input textarea" value="{{detail}}" placeholder="街道门牌等" maxlength="80" bindinput="onDetail" />
      </view>
    </view>

    <view class="ui-field default-row">
      <view class="default-left">
        <text class="ui-item-title">设为默认地址</text>
        <text class="ui-item-meta">下单优先使用该地址</text>
      </view>
      <switch checked="{{isDefault}}" color="#ff7a24" bindchange="onDefaultChange"></switch>
    </view>

    <view class="ui-footer" wx:if="{{id}}">
      <button class="ui-btn-danger" bindtap="onDelete">删除地址</button>
    </view>
  </view>

  <view class="ui-bottom-bar">
    <button class="ui-btn-primary" bindtap="onSave">{{id ? '保存修改' : '保存地址'}}</button>
  </view>
</view>
