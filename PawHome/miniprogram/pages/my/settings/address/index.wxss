page {
  background: #f7f8fa;
}

.map-card {
  position: relative;
  padding: 0;
  overflow: hidden;
}

.addr-map {
  width: 100%;
  height: 280rpx;
}

.map-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.86);
  backdrop-filter: blur(12px);
}

.map-empty-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
}

.map-empty-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #64748b;
}

.addr-item {
  align-items: stretch;
}

.addr-item--selected {
  border-color: rgba(255, 122, 36, 0.35);
  box-shadow: 0 14rpx 28rpx rgba(255, 122, 36, 0.16);
}

.addr-main {
  flex: 1;
  min-width: 0;
}

.addr-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  width: 100%;
}

.addr-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  flex: 1;
}

.addr-name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.addr-edit {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 84rpx;
  height: 52rpx;
  padding: 0 18rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  margin-left: auto;
  flex: none;
  white-space: nowrap;
  border-radius: 999rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  background: rgba(255, 122, 36, 0.08);
  color: #ff7a24;
}

.addr-meta {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #64748b;
}

.addr-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #475569;
  line-height: 1.6;
  word-break: break-all;
}

.addr-actions {
  margin-top: 18rpx;
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
}

.ui-btn-ghost.danger {
  border-color: rgba(239, 68, 68, 0.25);
  color: #ef4444;
}

.addr-empty-illus {
  width: 220rpx;
  height: 220rpx;
  margin: 0 auto 18rpx;
  opacity: 0.9;
}
