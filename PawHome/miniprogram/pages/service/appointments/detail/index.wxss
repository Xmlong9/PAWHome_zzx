page {
  background-color: #FFFFFF;
}

.page {
  padding: 24rpx 30rpx 40rpx 30rpx;
  box-sizing: border-box;
}

.card {
  border: 2rpx solid #EEEEEE;
  border-radius: 18rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111111;
  margin-bottom: 18rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 10rpx 0;
}

.label {
  font-size: 24rpx;
  color: #999999;
  width: 180rpx;
}

.val {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #111111;
  font-weight: 600;
}

.danger-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 16rpx;
  background-color: #FEE2E2;
  color: #991B1B;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

