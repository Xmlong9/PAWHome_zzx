page {
  background: #f7f8fa;
}

.detail-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
  background: #ffffff;
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
}

.detail-avatar {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  border: 6rpx solid #fff;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
  margin-bottom: 24rpx;
}

.detail-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.detail-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #0f172a;
}

.detail-card {
  padding: 16rpx 40rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 30rpx;
  color: #64748b;
}

.info-value {
  font-size: 30rpx;
  color: #0f172a;
  font-weight: 500;
}