page {
  background-color: #FFFFFF;
}

.service-page {
  padding-bottom: calc(env(safe-area-inset-bottom) + 150rpx);
}

/* Pet Selector */
.pet-selector {
  padding: 20rpx 30rpx 10rpx 30rpx;
}

.pet-scroll {
  width: 100%;
}

.pet-list {
  display: flex;
  flex-direction: row;
}

.pet-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  margin-right: 40rpx;
  height: 140rpx;
}

.pet-avatar-wrap {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
  transition: all 0.2s ease;
  padding: 0;
  border: 4rpx solid transparent;
  box-sizing: border-box;
  position: relative;
}

.pet-avatar-wrap.active {
  width: 100rpx;
  height: 100rpx;
  border-color: transparent;
}

.pet-check {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 36rpx;
  height: 36rpx;
  background-color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pet-check-inner {
  width: 28rpx;
  height: 28rpx;
  background-color: #333333;
  color: #FFFFFF;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.pet-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.pet-name {
  font-size: 26rpx;
  color: #999999;
}

.pet-name.active-text {
  font-size: 28rpx;
  color: #333333;
  font-weight: bold;
}

/* Section Common */
.section {
  padding: 10rpx 30rpx 40rpx 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 24rpx;
}

/* Service Items */
.item-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.service-item {
  padding: 30rpx;
  border-radius: 16rpx;
  background-color: #F7F8FA;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.service-item.active {
  background-color: #FFF8F3;
  border-color: #FF9E5E;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.item-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.item-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.item-body {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item-desc {
  font-size: 24rpx;
  color: #999999;
}

/* Store/Map */
.store-container {
  border-radius: 16rpx;
  overflow: hidden;
  background-color: #F7F8FA;
  margin-bottom: 24rpx;
}

.map-placeholder {
  width: 100%;
  height: 260rpx;
}

.map-img {
  width: 100%;
  height: 100%;
}

.store-list {
  display: flex;
  flex-direction: column;
}

.store-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background-color: #FFFFFF;
  margin: 0;
  border-radius: 0;
}

.store-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background-color: #EEEEEE;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.store-card.active {
  background-color: #FFFFFF;
}

.store-info {
  flex: 1;
}

.store-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.store-desc {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 4rpx;
}

.btn-select-store {
  background-color: #F2F2F2;
  color: #999999;
  font-size: 28rpx;
  padding: 16rpx 40rpx;
  border-radius: 12rpx;
  font-weight: bold;
}

.btn-select-store.btn-active {
  background-color: #FF9E5E;
  color: #000000;
}

/* Bottom Sheet */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  z-index: 9998;
}

.bottom-sheet {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background-color: #000000;
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  padding: 40rpx;
  box-sizing: border-box;
  z-index: 9999;
  padding-bottom: calc(env(safe-area-inset-bottom) + 40rpx);
  max-height: 70vh;
  overflow-y: auto;
}

.date-selector {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.date-item {
  flex: 1;
  height: 80rpx;
  background-color: #F7F8FA;
  color: #333333;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  margin: 0 10rpx;
  font-size: 28rpx;
}

.date-item:first-child {
  margin-left: 0;
}

.date-item:last-child {
  margin-right: 0;
}

.date-item.active {
  background-color: #FF9E5E;
  font-weight: bold;
}

.time-selector {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 40rpx;
}

.time-item {
  width: calc(33.33% - 14rpx);
  height: 80rpx;
  background-color: #F7F8FA;
  color: #333333;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.time-item:nth-child(3n) {
  margin-right: 0;
}

.time-item.active {
  background-color: #FF9E5E;
  font-weight: bold;
}

.remark-wrap {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
}

.remark-input {
  width: 100%;
  height: 120rpx;
  font-size: 28rpx;
  color: #333333;
}

.price-summary {
  margin-bottom: 40rpx;
}

.price-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.price-label {
  font-size: 26rpx;
  color: #999999;
}

.price-val {
  font-size: 26rpx;
  color: #999999;
}

.divider-line {
  height: 1rpx;
  background-color: #333333;
  margin-top: 30rpx;
}

.btn-submit-full {
  width: 100%;
  height: 96rpx;
  background-color: #FF9E5E;
  color: #000000;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 48rpx;
}

.time-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #F7F8FA;
  border-radius: 16rpx;
  padding: 26rpx 30rpx;
}

.time-row-text {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.time-row-btn {
  background-color: #FF9E5E;
  color: #000000;
  font-size: 28rpx;
  padding: 16rpx 40rpx;
  border-radius: 12rpx;
  font-weight: bold;
}

.page-bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 120rpx;
  padding: 0 30rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  background-color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 9997;
}

.page-total {
  font-size: 26rpx;
  color: #333333;
}

.page-total-val {
  color: #FF9E5E;
  font-size: 36rpx;
  font-weight: bold;
}

.page-btn {
  background-color: #111111;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: bold;
  padding: 18rpx 52rpx;
  border-radius: 48rpx;
}
