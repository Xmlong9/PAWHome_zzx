.favorites-page {
  min-height: 100vh;
  background: #f4f4f4;
  padding: 24rpx;
  box-sizing: border-box;
}

.item {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: #f9f9f9;
  flex-shrink: 0;
}

.meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.price {
  margin-top: 20rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #ff5b55;
}

.remove {
  width: 100rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #fff;
  border: 2rpx solid #e0e0e0;
  color: #666;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.empty {
  padding-top: 220rpx;
  text-align: center;
  font-size: 26rpx;
  color: #888;
}
