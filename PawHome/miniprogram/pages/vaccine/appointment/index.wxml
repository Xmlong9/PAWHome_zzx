<view class="page">
  <view class="pet-row">
    <view class="pet-chip {{selectedPetId==item.id?'active':''}}" wx:for="{{pets}}" wx:key="id" bindtap="selectPet" data-id="{{item.id}}">
      <image class="pet-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
      <view class="pet-name">{{item.name}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">选择疫苗</view>
    <view class="vaccine-card {{selectedVaccineId==item.id?'active':''}}" wx:for="{{vaccines}}" wx:key="id" bindtap="selectVaccine" data-id="{{item.id}}">
      <view class="vaccine-head">
        <view class="vaccine-name">{{item.name}}</view>
        <view class="vaccine-price">¥ {{item.price}}</view>
      </view>
      <view class="vaccine-sub">{{item.age}}</view>
      <view class="vaccine-sub">{{item.cycle}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">选择医院</view>
    <view class="map-card">
      <image class="map-img" src="/assets/images/home/advertise@1x.png" mode="aspectFill"></image>
    </view>
    <view class="hospital-card" wx:for="{{hospitals}}" wx:key="id">
      <view class="hospital-info">
        <view class="hospital-name">{{item.name}}</view>
        <view class="hospital-sub">距离 {{item.distance}} | 评分 {{item.rating}}</view>
        <view class="hospital-sub">营业时间：{{item.hours}}</view>
      </view>
      <view class="hospital-btn {{selectedHospitalId==item.id?'active':''}}" bindtap="selectHospital" data-id="{{item.id}}">选择</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">选择时间</view>
    <view class="day-row">
      <view class="day-item {{selectedDay==item.value?'active':''}}" wx:for="{{days}}" wx:key="key" bindtap="selectDay" data-key="{{item.value}}">{{item.label}}</view>
    </view>
    <view class="time-grid">
      <view class="time-item {{selectedSlotId==item.id?'active':''}}" wx:for="{{timeSlots}}" wx:key="id" bindtap="selectTime" data-id="{{item.id}}">{{item.timeLabel}}</view>
    </view>

    <view class="section-title section-title-small">备注信息</view>
    <view class="remark-wrap">
      <textarea class="remark-input" placeholder="请填写宠物特殊情况或其他需求" value="{{remark}}" bindinput="onRemarkInput" cursor-spacing="80" show-confirm-bar="false" maxlength="200"></textarea>
    </view>

    <view class="section-title section-title-small">费用明细</view>
    <view class="fee-row">
      <view class="fee-label">疫苗费用</view>
      <view class="fee-val">¥ {{selectedPrice}}</view>
    </view>
    <view class="fee-row">
      <view class="fee-label">接种服务费</view>
      <view class="fee-val">¥ 0</view>
    </view>
    <view class="fee-total">
      <view class="fee-label">总计</view>
      <view class="fee-total-val">¥ {{selectedPrice}}</view>
    </view>
  </view>

  <view class="page-footer">
    <view class="bottom-btn" bindtap="submit">
      <view class="bottom-btn-text">确认预约</view>
    </view>
  </view>
</view>
