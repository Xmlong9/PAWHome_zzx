.user-profile-page {
  min-height: 100vh;
  background-color: #ffffff;
  display: flex;
  flex-direction: column;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 44px; /* 小程序默认胶囊高度 */
  padding: 0 32rpx;
  background-color: #ffffff;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-back {
  width: 60rpx;
  height: 100%;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 40rpx;
  height: 40rpx;
  border: solid #333;
  border-width: 0 0 4rpx 4rpx;
  transform: rotate(45deg);
  margin-left: 20rpx;
  /* 去掉原先的 image 图片直接用纯 CSS 画一个黑色的返回箭头 */
}

.nav-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #333;
}

.nav-right {
  width: 60rpx; /* 占位平衡居中 */
}

/* 页面内容 */
.page-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* 第一行：头部信息 */
.header-section {
  display: flex;
  padding: 40rpx 32rpx;
  align-items: center;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background-color: #eee;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.info-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.id-row, .location-row {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 4rpx;
  display: flex;
  align-items: center;
}

.location-icon {
  margin-right: 4rpx;
}

.action-block {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.follow-btn, .msg-btn {
  background-color: #ff9e59;
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
  padding: 12rpx 32rpx;
  border-radius: 8rpx;
  text-align: center;
}

.follow-btn.following {
  background-color: #f5f5f5;
  color: #999;
}

.msg-btn {
  background-color: #f5f5f5;
  color: #333;
  border: 1rpx solid #ddd;
}

/* 第二行：统计与签名 */
.stats-section {
  display: flex;
  padding: 0 32rpx 20rpx;
  gap: 80rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.signature-section {
  padding: 0 32rpx 32rpx;
}

.signature-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
}

/* 第三行：Tabs */
.tabs-container {
  display: flex;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: #999;
  padding: 20rpx 0;
  position: relative;
}

.tab-item.active {
  color: #333;
  font-weight: bold;
}

.tab-line {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #333;
  border-radius: 2rpx;
}

/* 列表区域 (复用瀑布流样式) */
.list-container {
  flex: 1;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.waterfall-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.post-card {
  width: 48%;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.post-cover {
  width: 100%;
  height: 360rpx;
  background: #eee;
}

.post-title {
  font-size: 26rpx;
  color: #333;
  padding: 16rpx 16rpx 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.post-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 16rpx 16rpx;
}

.post-like {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.like-icon-img {
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
}

.post-views {
  font-size: 22rpx;
  color: #999;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}
