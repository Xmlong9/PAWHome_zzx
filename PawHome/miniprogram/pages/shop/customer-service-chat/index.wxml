<view class="cs-chat-page paw-route {{pageVisible ? 'is-visible' : ''}} {{pageLeaving ? 'is-leaving' : ''}}" style="padding-top: {{statusBarHeight + navBarHeight}}px;">
  <!-- Custom Navigation Bar -->
  <view class="custom-nav-bar" style="height: {{statusBarHeight + navBarHeight}}px; padding-top: {{statusBarHeight}}px;">
    <view class="nav-back" bindtap="goBack">
      <view class="icon-back"></view>
    </view>
    <view class="nav-title"></view>
    <view class="nav-right">
      <view class="icon-human"></view>
    </view>
  </view>

  <!-- Header Card -->
  <view class="header-card">
    <image class="header-avatar" src="https://api.dicebear.com/7.x/avataaars/svg?seed=Felix" mode="aspectFill"></image>
    <view class="header-info">
      <view class="header-name-row">
        <text class="header-name">尊贵的会员</text>
      </view>
      <view class="header-desc">专属客服随时为您服务</view>
      <view class="header-time" wx:if="{{sessionDisplayTime}}">对话时间：{{sessionDisplayTime}}</view>
      <view class="header-actions">
        <view class="btn-action" bindtap="switchToHuman">
          <view class="icon-msg"></view>
          <text>在线人工</text>
        </view>
      </view>
    </view>
  </view>

  <scroll-view
    class="msg-scroll"
    scroll-y
    scroll-with-animation
    scroll-into-view="{{scrollTo}}"
  >
    <view class="msg-padding-top"></view>

    <!-- Welcome Messages -->
    <view class="msg-row them" id="msg_welcome_1">
      <image class="avatar bot-avatar" src="../../../assets/images/shop/问号猫.png" mode="aspectFit" style="transform: scaleX(-1);"></image>
      <view class="bubble">亲，我是智能小宠，很高兴为您服务！</view>
    </view>
    <view class="msg-row them" id="msg_welcome_2">
      <image class="avatar bot-avatar" src="../../../assets/images/shop/问号猫.png" mode="aspectFit" style="transform: scaleX(-1);"></image>
      <view class="bubble">亲，您有任何疑问都可以向小宠咨询哦～</view>
    </view>

    <!-- Hot FAQs -->
    <view class="faq-list" wx:if="{{mode==='smart' && faqs.length > 0}}">
      <block wx:for="{{faqs}}" wx:key="id">
        <view class="faq-card" data-q="{{item.q}}" bindtap="tapFaq">
          <view class="faq-badge">热</view>
          <text class="faq-text">{{item.q}}</text>
          <view class="faq-arrow"></view>
        </view>
      </block>
    </view>

    <!-- History Messages -->
    <block wx:for="{{messages}}" wx:key="id">
      <view class="msg-time" wx:if="{{item.showTime && item.displayTime}}">{{item.displayTime}}</view>
      <view class="msg-row {{item.role==='user' ? 'me' : 'them'}}" id="msg_{{item.id}}">
        <image wx:if="{{item.role!=='user'}}" class="avatar bot-avatar" src="../../../assets/images/shop/问号猫.png" mode="aspectFit" style="transform: scaleX(-1);"></image>
        <view wx:if="{{item.type==='order_card'}}" class="order-card">
          <view class="order-card-title">订单已发送</view>
          <view class="order-card-row">
            <text class="order-card-label">订单号</text>
            <text class="order-card-value">{{item.orderCard.orderId}}</text>
          </view>
          <view class="order-card-row">
            <text class="order-card-label">金额</text>
            <text class="order-card-value">¥{{item.orderCard.amount}}</text>
          </view>
          <view class="order-card-row">
            <text class="order-card-label">下单</text>
            <text class="order-card-value">{{item.orderCard.displayTime}}</text>
          </view>
          <view class="order-card-items" wx:if="{{item.orderCard && item.orderCard.items && item.orderCard.items.length>0}}">
            <block wx:for="{{item.orderCard.items}}" wx:key="name">
              <view class="order-card-item">{{item.name}} x{{item.count}}</view>
            </block>
          </view>
        </view>
        <view wx:else class="bubble">
          <text wx:if="{{!item.isTyping}}" user-select="true" decode="true" style="white-space: pre-wrap;">{{item.isAnimating ? item.displayContent : item.content}}</text>
          <view class="typing-indicator" wx:else>
            <view class="typing-dot"></view>
            <view class="typing-dot"></view>
            <view class="typing-dot"></view>
          </view>
        </view>
      </view>
    </block>

    <view id="bottom" style="height: 40rpx;"></view>
  </scroll-view>

  <!-- Bottom Actions -->
  <view class="bottom-area">
    <scroll-view class="quick-actions" scroll-x enable-flex>
      <view class="quick-btn" bindtap="sendOrder">
        <view class="icon-order"></view>
        <text>发订单给客服</text>
        <view class="dot"></view>
      </view>
    </scroll-view>

    <view class="input-bar">
      <view class="input-wrap">
        <textarea
          class="input"
          value="{{text}}"
          placeholder="请输入想咨询的问题"
          bindinput="onInput"
          auto-height
          fixed
          show-confirm-bar="{{false}}"
          cursor-spacing="20"
        />
        <view class="icon-send-order"></view>
      </view>
      <view class="icon-plus" bindtap="send" wx:if="{{!text}}"></view>
      <view class="send-btn" bindtap="send" wx:else>发送</view>
    </view>
  </view>

  <view wx:if="{{showOrderSheet}}" class="sheet-mask {{orderSheetVisible ? 'show' : ''}}" bindtap="closeOrderSheet"></view>
  <view wx:if="{{showOrderSheet}}" class="sheet-panel {{orderSheetVisible ? 'show' : ''}}">
    <view class="sheet-title">选择订单</view>
    <view class="sheet-subtitle">最近 5 笔</view>
    <scroll-view class="sheet-list" scroll-y>
      <block wx:for="{{recentOrders}}" wx:key="id">
        <view class="sheet-item" data-id="{{item.id}}" bindtap="chooseOrder">
          <view class="sheet-item-title">{{item.titleText}}</view>
          <view class="sheet-item-meta">{{item.id}} · {{item.displayTime}} · ¥{{item.amount}}</view>
        </view>
      </block>
      <view class="sheet-empty" wx:if="{{!loadingOrders && recentOrders.length===0}}">暂无订单</view>
    </scroll-view>
  </view>
</view>
