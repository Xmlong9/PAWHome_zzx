.splash-container {
  width: 100vw;
  height: 100vh;
  position: relative;
  overflow: hidden;
}

.splash-bg {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
}

.skip-btn {
  position: absolute;
  top: 100rpx; /* safe area top + margin */
  right: 40rpx;
  background-color: rgba(0, 0, 0, 0.3);
  color: #fff;
  font-size: 26rpx;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  z-index: 10;
}
