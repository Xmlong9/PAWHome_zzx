<view class="page paw-route {{pageVisible ? 'is-visible' : ''}} {{pageLeaving ? 'is-leaving' : ''}}" style="padding-top: {{navHeight}}px">
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px">
    <view class="nav-content">
      <view class="back-btn" bindtap="goBack">
        <view class="back-arrow">←</view>
      </view>
      <view class="nav-title">{{title}}</view>
      <view class="nav-right"></view>
    </view>
  </view>

  <scroll-view
    scroll-y
    class="scroll"
    scroll-with-animation
    scroll-top="{{scrollTop}}"
    style="padding-bottom: calc({{inputBarHeight}}px + {{keyboardHeight}}px + env(safe-area-inset-bottom));"
  >
    <view class="empty" wx:if="{{!messages || messages.length === 0}}">
      <view class="empty-title">开始聊天吧</view>
      <view class="empty-desc">发一条消息打个招呼</view>
    </view>
    <block wx:for="{{messages}}" wx:key="renderKey">
      <view class="row {{item.from === 'me' ? 'me' : 'them'}}">
        <image wx:if="{{item.from === 'me' && myAvatar}}" class="avatar" src="{{myAvatar}}" mode="aspectFill"></image>
        <view wx:elif="{{item.from === 'me'}}" class="avatar avatar-empty"></view>
        <image wx:elif="{{peerAvatar}}" class="avatar" src="{{peerAvatar}}" mode="aspectFill"></image>
        <view wx:else class="avatar avatar-empty"></view>
        <view class="bubble">
          <text user-select>{{item.text}}</text>
        </view>
      </view>
    </block>
  </scroll-view>

  <view
    class="input-bar"
    style="padding-bottom: calc(env(safe-area-inset-bottom)); transform: translateY(-{{keyboardHeight}}px);"
  >
    <view class="input-wrap">
      <input
        class="text-input"
        placeholder="发消息..."
        value="{{inputValue}}"
        confirm-type="send"
        cursor-spacing="80"
        adjust-position="true"
        bindinput="onInput"
        bindconfirm="onSend"
        bindfocus="onFocus"
        bindblur="onBlur"
      />
      <view class="send-btn {{canSend ? 'active' : ''}}" catchtap="onSendTap">发送</view>
    </view>
  </view>
</view>
