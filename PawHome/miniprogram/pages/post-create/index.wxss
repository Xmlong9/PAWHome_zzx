page {
  height: 100vh;
  width: 100vw;
  background-color: #fff;
  overflow: hidden; /* Prevent page scroll if container scrolls */
}

.container {
    padding-top: calc(44px + env(safe-area-inset-top)); 
    background-color: #fff;
    height: 100vh;
    width: 100vw;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    padding-left: 0;
    padding-right: 0;
    padding-bottom: 0;
  }

  .scroll-content {
    flex: 1;
    overflow-y: auto;
    padding: 0;
  }

  .content-wrap {
    padding: 20rpx 32rpx 40rpx 32rpx;
  }

/* Custom Nav */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: #fff;
  z-index: 100;
  border-bottom: 1rpx solid #f5f5f5;
}

.nav-content {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  position: relative;
}

.back-btn,
.nav-right {
  width: 88rpx;
  height: 100%;
  display: flex;
  align-items: center;
}

.back-arrow {
  font-size: 40rpx;
  font-weight: 300;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  pointer-events: none;
}

.publish-btn {
  background: #FF9E59;
  color: #fff;
  padding: 10rpx 32rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.fab-publish {
  position: fixed;
  right: 32rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 200;
  background: #FF9E59;
  color: #fff;
  padding: 18rpx 36rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.15);
}

/* Tabs */
.type-tabs {
  display: flex;
  gap: 32rpx;
  margin-top: 20rpx;
  margin-bottom: 32rpx;
  justify-content: flex-start; /* Align left */
}

.tab-item {
  padding: 12rpx 32rpx;
  background: #f5f5f5;
  color: #666;
  border-radius: 8rpx;
  font-size: 28rpx;
  transition: all 0.2s;
}

.tab-item.active {
  background: #000;
  color: #fff;
  font-weight: 500;
}

/* Input */
.input-section {
  margin-bottom: 32rpx;
}

.content-input {
  width: 100%;
  height: 200rpx;
  font-size: 30rpx;
  line-height: 1.5;
  color: #333;
}

/* Media */
.media-section {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 40rpx;
  justify-content: flex-start; /* Align left */
}

.media-item {
  width: 218rpx;
  height: 218rpx;
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
}

.media-preview {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.video-badge {
  position: absolute;
  bottom: 8rpx;
  left: 8rpx;
  color: #fff;
  font-size: 24rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.5);
}

.upload-btn {
  width: 218rpx;
  height: 218rpx;
  background: #f9f9f9;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #ddd;
}

.plus-icon {
  font-size: 60rpx;
  color: #ccc;
  font-weight: 300;
  margin-top: -8rpx;
}

/* Options */
.options-list {
  border-top: 1rpx solid #f5f5f5;
}

.option-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.option-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 30rpx;
  color: #333;
}

.option-icon {
  width: 40rpx;
  text-align: center;
  font-size: 32rpx;
  color: #999;
}

.option-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.option-value {
  font-size: 28rpx;
  color: #666;
}

.arrow-icon {
  color: #ccc;
  font-size: 28rpx;
}
