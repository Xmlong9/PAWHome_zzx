<view class="order-page">
  <scroll-view class="tabs" scroll-x="true" enable-flex>
    <block wx:for="{{tabs}}" wx:key="key">
      <view class="tab {{currentStatus===item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="switchStatus">
        {{item.label}}
      </view>
    </block>
  </scroll-view>

  <view class="order-list">
    <block wx:for="{{list}}" wx:key="id">
      <view class="order-card {{highlight===item.id ? 'highlight' : ''}}" data-id="{{item.id}}" bindtap="goToDetail">
        <view class="card-header">
          <view class="shop-info">
            <text class="platform-tag">自营</text>
            <text class="shop-name">PAWHome 官方精选</text>
            <text class="arrow">›</text>
          </view>
          <text class="status {{item.status}}">{{item.statusText}}</text>
        </view>

        <view class="goods-list">
          <block wx:for="{{item.items || []}}" wx:key="id" wx:for-item="goods">
            <view class="goods-item" data-product-id="{{goods.id}}" catchtap="goToProductDetail">
              <image class="goods-thumb" src="{{goods.imageUrl}}" mode="aspectFill"></image>
              <view class="goods-info">
                <view class="goods-name">{{goods.name}}</view>
                <view class="goods-spec">{{goods.spec}}</view>
                <view class="goods-tags">
                  <text class="tag">支持7天无理由</text>
                </view>
              </view>
              <view class="goods-price-box">
                <view class="goods-price">¥{{goods.price}}</view>
                <view class="goods-count">x{{goods.count}}</view>
              </view>
            </view>
          </block>
          <view class="fallback-goods" wx:if="{{!item.items}}">{{item.productNames.join('、')}}</view>
        </view>

        <view class="card-footer">
          <view class="total-row">
            <text class="total-label">实付款</text>
            <text class="total-symbol">¥</text>
            <text class="total-amount">{{item.amount}}</text>
          </view>
          <view class="action-row">
            <view class="btn-more" data-id="{{item.id}}" catchtap="onDeleteOrder">更多</view>
            <view class="btn-group">
              <view class="btn outline" data-id="{{item.id}}" catchtap="onViewLogistics" wx:if="{{item.status === 'shipping' || item.status === 'done'}}">查看物流</view>
              <view class="btn primary" data-id="{{item.id}}" catchtap="onConfirmReceipt" wx:if="{{item.status === 'shipping'}}">确认收货</view>
              <view class="btn primary" data-id="{{item.id}}" catchtap="onPayOrder" wx:elif="{{item.status === 'pending_pay'}}">去支付</view>
              <view class="btn outline" catchtap="stopProp" wx:elif="{{item.status === 'done'}}">评价</view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- 确认收货半屏弹窗 -->
  <view class="half-modal {{showConfirmModal ? 'show' : ''}}" catchtouchmove="stopProp">
    <view class="mask" catchtap="closeConfirmModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">确认收到货了吗</text>
        <text class="close-btn" catchtap="closeConfirmModal">×</text>
      </view>
      
      <view class="modal-body" wx:if="{{confirmingOrder}}">
        <view class="confirm-card">
          <view class="confirm-shop">
            <view class="check-icon active"></view>
            <text class="shop-name">PAWHome 官方精选</text>
            <text class="status-tag">已发货</text>
          </view>
          
          <view class="confirm-goods" wx:for="{{confirmingOrder.items}}" wx:key="id" wx:for-item="goods">
            <image class="goods-thumb" src="{{goods.imageUrl}}" mode="aspectFill"></image>
            <view class="goods-info">
              <view class="goods-name">{{goods.name}}</view>
              <view class="goods-tags"><text class="tag">支持7天无理由</text></view>
            </view>
            <view class="goods-price-box">
              <view class="goods-price">¥{{goods.price}}</view>
              <view class="goods-count">x{{goods.count}}</view>
            </view>
          </view>
          
          <view class="confirm-delivery">
            <text class="icon">📦</text>
            <text>商家选择无需物流配送</text>
          </view>
          
          <view class="confirm-total">
            实付款<text class="price-symbol">¥</text><text class="price-num">{{confirmingOrder.amount}}</text>
          </view>
        </view>
        
        <view class="confirm-tips">为保障你的售后权益，请确认无误后再确认收货</view>
      </view>
      
      <view class="modal-footer">
        <view class="confirm-btn" bindtap="submitConfirmReceipt">确认收货</view>
      </view>
    </view>
  </view>
</view>
