.service-page {
  min-height: 100vh;
  background: #ffffff;
  padding: 32rpx;
  box-sizing: border-box;
}

.top-card {
  background: #f7f8fa;
  border-radius: 24rpx;
  padding: 32rpx;
  position: relative;
  min-height: 200rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.top-bg-image {
  position: absolute;
  left: -20rpx;
  top: 10rpx;
  width: 160rpx;
  height: 160rpx;
  z-index: 1;
  transform: scaleX(-1);
}

.top-content {
  position: relative;
  z-index: 2;
  margin-left: 140rpx;
}

.title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  line-height: 1.4;
}

.quick-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.quick-btn {
  background: #fff;
  border: 1rpx solid #eaeaea;
  border-radius: 8rpx;
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  color: #666;
}

.card {
  background: #f7f8fa;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.human-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  align-items: flex-end;
}

.human-info {
  flex: 1;
}

.human-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.human-sub {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.human-sub.wait-count {
  margin-bottom: 0;
}

.human-btn {
  background: #f4a261;
  color: #fff;
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.smart-btn {
  background: #ff6d6d;
  color: #fff;
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.contact-card .card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.contact-item:last-child {
  margin-bottom: 0;
}

.contact-item .icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.contact-item .text {
  font-size: 26rpx;
  color: #333;
}

.history-card .card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 0;
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.history-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.history-action {
  font-size: 24rpx;
  color: #ff6d6d;
}

.history-action.danger {
  color: #999;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eaeaea;
}

.history-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.history-empty {
  padding-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

.history-title {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.history-status {
  font-size: 24rpx;
  color: #999;
}

.history-time {
  font-size: 24rpx;
  color: #999;
}
