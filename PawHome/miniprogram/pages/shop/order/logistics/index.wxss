.logistics-page {
  min-height: 100vh;
  background: #f4f4f4;
  padding-bottom: env(safe-area-inset-bottom);
}

.map-header {
  width: 100%;
  height: 400rpx;
  position: relative;
}

.map {
  width: 100%;
  height: 100%;
}

.content-wrapper {
  position: relative;
  margin-top: -40rpx;
  padding: 0 24rpx;
  z-index: 2;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

/* Logistics Card */
.company-info {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  flex-wrap: nowrap;
}

.company-logo {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #eee;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.company-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-right: 12rpx;
  white-space: nowrap;
}

.tracking-no {
  font-size: 26rpx;
  color: #333;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.copy-btn, .call-btn {
  font-size: 22rpx;
  color: #666;
  margin-left: 12rpx;
  padding: 4rpx 16rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 20rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.status-summary {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.status-icon {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ff5b55;
  margin-right: 16rpx;
  position: relative;
  top: -2rpx;
}

.status-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff5b55;
  margin-right: 16rpx;
}

.status-time {
  font-size: 24rpx;
  color: #999;
}

.status-desc {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
  margin-left: 32rpx;
  margin-bottom: 24rpx;
}

.feedback-box {
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-left: 32rpx;
  margin-bottom: 24rpx;
}

.feedback-title {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.feedback-btns {
  display: flex;
  gap: 20rpx;
}

.feedback-btn {
  flex: 1;
  height: 64rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 500;
}

.feedback-btn.bad {
  background: #fff;
  color: #666;
  border: 1rpx solid #eee;
}

.feedback-btn.good {
  background: #fff;
  color: #333;
  border: 1rpx solid #eee;
}

.logistics-detail {
  margin-left: 32rpx;
  margin-top: 32rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 32rpx;
}

.timeline {
  position: relative;
}

.timeline::before {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 16rpx;
  bottom: 16rpx;
  width: 2rpx;
  background: #eee;
}

.timeline-item {
  position: relative;
  padding-left: 40rpx;
  margin-bottom: 32rpx;
}

.timeline-item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 10rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ccc;
  border: 4rpx solid #fff;
}

.timeline-item:last-child {
  margin-bottom: 0;
}

.timeline-item .time {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.timeline-item .desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
}

.toggle-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.arrow {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-right: 2rpx solid #999;
  border-bottom: 2rpx solid #999;
  margin-left: 8rpx;
  transition: transform 0.3s;
}

.arrow.down {
  transform: rotate(45deg) translateY(-4rpx);
}

.arrow.up {
  transform: rotate(-135deg) translateY(-4rpx);
}

/* Address Card */
.address-card {
  display: flex;
  align-items: flex-start;
}

.address-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  margin-top: 4rpx;
}

.address-info {
  flex: 1;
}

.address-detail {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.user-info {
  font-size: 24rpx;
  color: #666;
  display: flex;
  align-items: center;
}

.user-info .tag {
  font-size: 20rpx;
  color: #ff5b55;
  border: 1rpx solid rgba(255, 91, 85, 0.3);
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  margin-left: 12rpx;
}

/* Order Card */
.order-card {
  padding-bottom: 16rpx;
}

.shop-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.goods-item {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
  background: #f7f8fa;
  padding: 16rpx;
  border-radius: 12rpx;
}

.goods-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  background: #fff;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
}

.goods-name {
  font-size: 26rpx;
  color: #333;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.goods-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.goods-tags .tag {
  font-size: 20rpx;
  color: #00b36b;
  border: 1rpx solid rgba(0, 179, 107, 0.3);
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.goods-price-box {
  text-align: right;
}

.goods-price {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.goods-count {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.order-detail {
  padding: 24rpx 0 0;
  border-top: 1rpx solid #f0f0f0;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.detail-row:last-child {
  margin-bottom: 0;
}

.detail-row .label {
  font-size: 26rpx;
  color: #666;
}

.detail-row .value {
  font-size: 26rpx;
  color: #333;
}

.detail-row.total-row {
  margin-top: 24rpx;
  margin-bottom: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed #eee;
}

.detail-row .value.highlight {
  color: #ff5b55;
  font-weight: 600;
  font-size: 30rpx;
}

.copy-small {
  font-size: 22rpx;
  color: #666;
  border: 1rpx solid #ddd;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
}