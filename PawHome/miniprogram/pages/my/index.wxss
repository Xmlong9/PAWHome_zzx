.my-page {
  min-height: 100vh;
  background: #fff;
  box-sizing: border-box;
  padding-bottom: 40rpx;
  position: relative;
  overflow: hidden; /* 防止背景溢出产生横向滚动条 */
}

/* 右上角灰色椭圆背景 */
.header-blob {
  position: absolute;
  right: -100rpx;
  top: -100rpx;
  width: 480rpx;
  height: 300rpx;
  background: #B3B3B3;
  border-radius: 9999rpx;
  z-index: 0;
  animation: rollFromLeftToRight 0.8s ease-out forwards;
}

/* User Section */
.user-section {
  display: flex;
  align-items: center;
  padding: 32rpx 40rpx;
  background: transparent;
  position: relative;
  z-index: 1; /* 保证内容在背景之上 */
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #eee;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.uid {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.location {
  font-size: 24rpx;
  color: #999;
}

.edit-btn {
  background: #ff9e59;
  color: #111;
  font-size: 24rpx;
  font-weight: 500;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
}

.divider {
  height: 2rpx;
  background: #eee;
  margin: 0 40rpx;
}

/* Pet Card Section */
.pet-card-wrap {
  padding: 40rpx;
  position: relative;
  background: #fff;
}

.cat-head-decor {
  position: absolute;
  right: 60rpx;
  top: -10rpx;
  width: 180rpx;
  height: 120rpx;
  z-index: 2;
}

.pet-card {
  background: linear-gradient(180deg, #FFAD73 0%, #FF4242 100%);
  border: 4rpx solid #111;
  border-radius: 32rpx;
  padding: 24rpx 0 0 0; /* 左右 padding 也设为 0，让内层自然撑满 */
  position: relative;
  z-index: 1;
  overflow: hidden; /* 防止子元素溢出圆角 */
}

.pet-card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111;
  margin-bottom: 16rpx;
  padding-left: 36rpx; /* 补偿因为去掉了外层 padding 导致的标题左移 */
}

.pet-content {
  background: linear-gradient(180deg, #FFFFFF 0%, #FFCFA2 100%);
  border-top: 4rpx solid #111;
  border-bottom: none; /* 去掉底部边框，与外层贴合 */
  border-radius: 24rpx 24rpx 0 0; /* 只保留上方的圆角 */
  padding: 24rpx 36rpx; /* 增加内层的左右 padding 保持内容不贴边 */
  display: flex;
  gap: 24rpx;
  margin: 0; /* 移除负边距 */
}

.pet-avatar-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid #111;
  overflow: hidden;
  flex-shrink: 0;
  background: #fff;
}

.pet-avatar {
  width: 100%;
  height: 100%;
}

.pet-info {
  flex: 1;
}

.pet-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.pet-name-wrap {
  border-bottom: 2rpx solid #111;
  padding-bottom: 8rpx;
  flex: 1;
  margin-right: 24rpx;
}

.pet-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #111;
}

.pet-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-top: -10rpx;
}

.pet-action-text {
  font-size: 20rpx;
  color: #555;
  padding: 10rpx 20rpx;
  margin-right: -20rpx;
}

.pet-detail-grid {
  display: flex;
  flex-wrap: wrap;
  row-gap: 12rpx;
  column-gap: 16rpx;
}

.detail-item {
  width: calc(50% - 8rpx);
  font-size: 22rpx;
  color: #333;
}

.detail-item.full-width {
  width: 100%;
}

.detail-item .label {
  color: #666;
}

.detail-item .value {
  color: #111;
  font-weight: 500;
}

/* Stats Section */
.stats-section {
  display: flex;
  justify-content: space-around;
  padding: 32rpx 0;
  background: #fff;
  margin-bottom: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 600;
  color: #111;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
}

/* List Menu */
.menu-list {
  background: #fff;
  padding: 0 32rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.menu-icon {
  font-size: 32rpx;
}

.menu-text {
  font-size: 28rpx;
  color: #333;
}

.arrow {
  font-size: 32rpx;
  color: #ccc;
}
