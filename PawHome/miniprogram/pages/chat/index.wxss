page {
  height: 100vh;
  width: 100vw;
  background: #f6f7f9;
  overflow: hidden;
}

.page {
  height: 100vh;
  width: 100vw;
  box-sizing: border-box;
  position: relative;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: #fff;
  z-index: 100;
  border-bottom: 1rpx solid #f0f0f0;
}

.nav-content {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  position: relative;
}

.back-btn,
.nav-right {
  width: 88rpx;
  height: 44px;
  display: flex;
  align-items: center;
}

.back-arrow {
  font-size: 36rpx;
  color: #333;
}

.nav-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  pointer-events: none;
}

.scroll {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding-top: calc(44px + env(safe-area-inset-top));
}

.empty {
  padding: 260rpx 0 120rpx;
  text-align: center;
  color: #94a3b8;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #475569;
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.row {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 24rpx;
  gap: 16rpx;
}

.row.me {
  flex-direction: row-reverse;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #eaeaea;
}

.avatar-empty {
  background: #eaeaea;
}

.bubble {
  max-width: 560rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  font-size: 30rpx;
  line-height: 1.4;
  color: #222;
  background: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.row.me .bubble {
  background: #FF9E59;
  color: #fff;
}

.input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  z-index: 200;
  border-top: 1rpx solid #f0f0f0;
}

.input-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}

.text-input {
  flex: 1;
  height: 72rpx;
  background: #f6f7f9;
  border-radius: 36rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #333;
}

.send-btn {
  width: 120rpx;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  background: #e9e9e9;
  color: #999;
}

.send-btn.active {
  background: #FF9E59;
  color: #fff;
}
