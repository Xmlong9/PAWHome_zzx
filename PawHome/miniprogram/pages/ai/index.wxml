<view class="ai-page">
  <view class="hero-card">
    <image class="hero-icon" src="/assets/icons/tab/ai-pet@1x.png" mode="aspectFit"></image>
    <view class="hero-title">AI宠</view>
    <view class="hero-desc">把养宠灵感、护理建议和日常问题放到一个入口里</view>
  </view>

  <view class="section-title">你可以在这里做什么</view>

  <view class="highlight-list">
    <view class="highlight-card" wx:for="{{highlights}}" wx:key="id">
      <view class="highlight-title">{{item.title}}</view>
      <view class="highlight-desc">{{item.desc}}</view>
    </view>
  </view>

  <view class="primary-btn" bindtap="showComingSoon">开始体验</view>
</view>
