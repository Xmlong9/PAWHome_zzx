page {
  background-color: #fff;
}

.login-container {
  width: 100vw;
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

/* Top Section */
.top-section {
  position: relative;
  width: 100%;
  height: 500rpx;
  overflow: hidden;
}

/* Base floating animation for circles */
@keyframes float {
  0% {
    transform: translate(0, 0) scale(1) rotate(0deg);
  }
  33% {
    transform: translate(12rpx, -12rpx) scale(1.03) rotate(3deg);
  }
  66% {
    transform: translate(-8rpx, 8rpx) scale(0.97) rotate(-3deg);
  }
  100% {
    transform: translate(0, 0) scale(1) rotate(0deg);
  }
}

.gooey-container {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  /* Reduced gooey filter strength for a more subtle, bubbly merge */
  filter: url('#goo');
}

.bg-circle-orange-wrap, .bg-circle-grey-wrap {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  /* Bouncy physics curve for the switch translation */
  transition: transform 1.2s cubic-bezier(0.68, -0.6, 0.32, 1.6);
}

.bg-circle-orange {
  position: absolute;
  top: -60rpx;
  left: -80rpx;
  width: 400rpx;
  height: 400rpx;
  background-color: #FFA056;
  border-radius: 45% 55% 40% 60% / 55% 45% 60% 40%; /* slightly irregular organic shape */
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: float 6s ease-in-out infinite;
  /* Smooth transition for border-radius morphing */
  transition: border-radius 1.2s ease, width 1.2s ease, height 1.2s ease, left 1.2s cubic-bezier(0.68, -0.6, 0.32, 1.6);
}

.bg-circle-grey {
  position: absolute;
  top: -80rpx;
  left: 360rpx;
  width: 460rpx;
  height: 460rpx;
  background-color: #A6A6A6;
  border-radius: 55% 45% 60% 40% / 45% 55% 40% 60%; /* slightly irregular organic shape */
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: float 8s ease-in-out infinite reverse;
  transition: border-radius 1.2s ease, width 1.2s ease, height 1.2s ease, left 1.2s cubic-bezier(0.68, -0.6, 0.32, 1.6);
}

.hi-text {
  font-size: 100rpx;
  font-weight: bold;
  color: #333;
  margin-top: 60rpx;
  margin-right: 40rpx;
  font-family: 'Comic Sans MS', cursive, sans-serif;
  transform: rotate(-10deg);
  transition: all 0.4s ease;
  opacity: 1;
}

.welcome-text {
  font-size: 52rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  margin-top: 80rpx;
  margin-left: -40rpx;
  margin-right: 0rpx;
  transition: all 0.4s ease;
  opacity: 1;
}

.cat-image {
  position: absolute;
  bottom: 0;
  left: 60rpx;
  width: 320rpx;
  height: 320rpx;
  z-index: 3;
}

.register-top .bg-circle-orange {
  left: 360rpx;
  width: 460rpx;
  height: 460rpx;
  border-radius: 55% 45% 60% 40% / 45% 55% 40% 60%;
  z-index: 2;
}

.register-top .bg-circle-grey {
  left: -120rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 45% 55% 40% 60% / 55% 45% 60% 40%;
  z-index: 1;
}

/* Removed .register-top .cat-image to keep it identical to login state */

/* Form Card */
.form-card {
  position: relative;
  margin-top: -60rpx;
  background-color: #fff;
  border-radius: 80rpx 80rpx 0 0;
  padding: 60rpx 60rpx;
  z-index: 10;
  border: 4rpx solid #333;
  border-bottom: none;
  min-height: calc(100vh - 440rpx);
  box-shadow: 0 -10rpx 20rpx rgba(0,0,0,0.05);
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.fade-in-up {
  animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.form-item {
  margin-bottom: 40rpx;
}

.label {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.input-wrap {
  border: 4rpx solid #333;
  border-radius: 40rpx;
  height: 90rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  background-color: #fff;
}

.input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #333;
}

.sms-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sms-input-wrap {
  flex: 1;
  margin-right: 20rpx;
}

.sms-btn {
  width: 200rpx !important;
  height: 90rpx;
  line-height: 82rpx;
  border: 4rpx solid #333;
  border-radius: 40rpx;
  background-color: #fff;
  font-size: 26rpx;
  color: #333;
  padding: 0;
  margin: 0 !important;
  font-weight: bold;
  display: flex;
  justify-content: center;
  align-items: center;
}

.forgot-pwd {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-right: 10rpx;
}

.small-text {
  font-size: 24rpx;
  color: #666;
}

.divider {
  margin: 0 10rpx;
  color: #999;
  font-size: 24rpx;
}

.action-btns {
  margin-top: 60rpx;
}

.btn-primary {
  width: 100% !important;
  height: 90rpx;
  line-height: 82rpx;
  background-color: #FFA056;
  border: 4rpx solid #333;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx !important;
  display: flex;
  justify-content: center;
  align-items: center;
}

.btn-secondary {
  width: 100% !important;
  height: 90rpx;
  line-height: 82rpx;
  background-color: #fff;
  border: 4rpx solid #333;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: flex;
  justify-content: center;
  align-items: center;
}

.extra-actions {
  margin-top: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.link-text {
  font-size: 26rpx;
  color: #666;
  text-decoration: underline;
}

/* User Info Modal */
.userinfo-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0,0,0,0.6);
  z-index: 100;
  display: flex;
  justify-content: center;
  align-items: center;
}

.userinfo-content {
  width: 600rpx;
  background-color: #fff;
  border-radius: 40rpx;
  border: 4rpx solid #333;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 40rpx;
}

.avatar-wrapper {
  padding: 0;
  width: 120rpx !important;
  border-radius: 16rpx;
  margin-bottom: 40rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
}

.nickname-wrapper {
  display: flex;
  align-items: center;
  width: 100%;
  border-bottom: 2rpx solid #eee;
  padding-bottom: 20rpx;
}

.nickname-label {
  font-size: 30rpx;
  margin-right: 20rpx;
}

.nickname-input {
  flex: 1;
  font-size: 30rpx;
}
